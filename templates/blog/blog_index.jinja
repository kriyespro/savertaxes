{% extends "base.jinja" %}

{% block content %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-2">Tax Guides & Blog</h1>
  <p class="text-gray-600 dark:text-gray-400 mb-8">Expert guides on income tax saving, GST, ITR filing, and investments for FY {{ CURRENT_FY }}.</p>

  {# Category pills #}
  <div class="flex flex-wrap gap-2 mb-8">
    <a href="{{ url('blog:index') }}"
       class="px-4 py-2 rounded-full text-sm font-medium transition-colors {% if not active_category %}bg-primary text-white{% else %}bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 hover:bg-gray-200{% endif %}">
      All
    </a>
    {% for cat in categories %}
    <a href="{{ url('blog:category', args=[cat.slug]) }}"
       class="px-4 py-2 rounded-full text-sm font-medium transition-colors {% if active_category == cat.slug %}bg-primary text-white{% else %}bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 hover:bg-gray-200{% endif %}">
      {{ cat.name }}
    </a>
    {% endfor %}
  </div>

  {# Articles grid #}
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {% for article in articles %}
    <a href="{{ article.get_absolute_url() }}"
       class="group bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 hover:border-primary hover:shadow-md transition-all overflow-hidden">
      <div class="p-6">
        <div class="flex items-center gap-2 mb-3">
          {% if article.category %}
          <span class="text-xs font-medium text-primary bg-primary/10 px-2 py-0.5 rounded">{{ article.category.name }}</span>
          {% endif %}
          <span class="text-xs text-gray-400">FY {{ article.fy_applicable }}</span>
        </div>
        <h2 class="font-semibold text-gray-900 dark:text-white text-sm leading-snug mb-2 group-hover:text-primary transition-colors line-clamp-2">{{ article.title }}</h2>
        <p class="text-xs text-gray-500 dark:text-gray-400 line-clamp-3">{{ article.excerpt }}</p>
        <div class="mt-4 flex items-center gap-3 text-xs text-gray-400">
          {% if article.author %}<span>{{ article.author.name }}</span>{% endif %}
          <span>{{ article.reading_time }} min read</span>
          {% if article.published_at %}<span>{{ article.published_at.strftime('%d %b %Y') }}</span>{% endif %}
        </div>
      </div>
    </a>
    {% else %}
    <div class="col-span-3 py-16 text-center">
      <p class="text-gray-400">No articles yet. Add via <a href="/sd/" class="text-primary underline">admin panel</a>.</p>
    </div>
    {% endfor %}
  </div>

  {# Pagination #}
  {% if is_paginated %}
  <div class="flex justify-center gap-2 mt-10">
    {% if page_obj.has_previous() %}
    <a href="?page={{ page_obj.previous_page_number() }}" class="px-4 py-2 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg text-sm hover:border-primary transition-colors">← Previous</a>
    {% endif %}
    <span class="px-4 py-2 bg-primary text-white rounded-lg text-sm">{{ page_obj.number }}</span>
    {% if page_obj.has_next() %}
    <a href="?page={{ page_obj.next_page_number() }}" class="px-4 py-2 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg text-sm hover:border-primary transition-colors">Next →</a>
    {% endif %}
  </div>
  {% endif %}
</div>
{% endblock %}
