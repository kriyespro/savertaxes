{% extends "base.jinja" %}

{% block schema %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "{{ article.title }}",
  "description": "{{ article.excerpt }}",
  "url": "{{ canonical_url }}",
  "datePublished": "{{ article.published_at.isoformat() if article.published_at else '' }}",
  "dateModified": "{{ article.updated_at.isoformat() }}",
  {% if article.author %}
  "author": {
    "@type": "Person",
    "name": "{{ article.author.name }}",
    "jobTitle": "{{ article.author.title }}"
  },
  {% endif %}
  "publisher": {
    "@type": "Organization",
    "name": "TaxSaver India",
    "url": "{{ request.scheme }}://{{ request.get_host() }}"
  }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ request.scheme }}://{{ request.get_host() }}/" },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": "{{ request.scheme }}://{{ request.get_host() }}/blog/" },
    {% if article.category %}
    { "@type": "ListItem", "position": 3, "name": "{{ article.category.name }}", "item": "{{ request.scheme }}://{{ request.get_host() }}/blog/{{ article.category.slug }}/" },
    { "@type": "ListItem", "position": 4, "name": "{{ article.title }}", "item": "{{ canonical_url }}" }
    {% else %}
    { "@type": "ListItem", "position": 3, "name": "{{ article.title }}", "item": "{{ canonical_url }}" }
    {% endif %}
  ]
}
</script>
{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">

  {# Breadcrumb #}
  <nav class="text-sm text-gray-500 dark:text-gray-400 mb-4" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 flex-wrap">
      <li><a href="{{ url('pages:home') }}" class="hover:text-primary">Home</a></li>
      <li>/</li>
      <li><a href="{{ url('blog:index') }}" class="hover:text-primary">Blog</a></li>
      {% if article.category %}
      <li>/</li>
      <li><a href="{{ url('blog:category', args=[article.category.slug]) }}" class="hover:text-primary">{{ article.category.name }}</a></li>
      {% endif %}
      <li>/</li>
      <li class="text-gray-900 dark:text-white font-medium truncate max-w-xs">{{ article.title }}</li>
    </ol>
  </nav>

  <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">

    {# ── Article Body ───────────────────────────────────── #}
    <article class="lg:col-span-3">

      {# FY badge + category #}
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <span class="inline-flex items-center gap-1 bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 text-green-700 dark:text-green-400 text-xs font-medium px-3 py-1 rounded-full">
          ✓ FY {{ article.fy_applicable }}
        </span>
        {% if article.category %}
        <span class="text-xs font-medium text-primary bg-primary/10 px-3 py-1 rounded-full">{{ article.category.name }}</span>
        {% endif %}
        {% if article.is_featured %}
        <span class="text-xs font-medium text-amber-700 bg-amber-50 dark:bg-amber-900/20 dark:text-amber-400 px-3 py-1 rounded-full">Featured</span>
        {% endif %}
      </div>

      {# Title #}
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white leading-tight mb-4">{{ article.title }}</h1>

      {# Meta row #}
      <div class="flex flex-wrap items-center gap-4 text-sm text-gray-500 dark:text-gray-400 mb-6 pb-6 border-b border-gray-200 dark:border-gray-700">
        {% if article.author %}
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold text-sm">
            {{ article.author.name[0] }}
          </div>
          <div>
            <p class="text-gray-900 dark:text-white font-medium text-xs">{{ article.author.name }}</p>
            {% if article.author.is_ca %}
            <p class="text-xs text-green-600 dark:text-green-400">✓ CA Verified</p>
            {% else %}
            <p class="text-xs text-gray-400">{{ article.author.title }}</p>
            {% endif %}
          </div>
        </div>
        {% endif %}
        {% if article.published_at %}
        <span>{{ article.published_at.strftime('%d %b %Y') }}</span>
        {% endif %}
        <span>{{ article.reading_time }} min read</span>
        {% if article.updated_at %}
        <span>Updated {{ article.updated_at.strftime('%d %b %Y') }}</span>
        {% endif %}
      </div>

      {# Excerpt #}
      <p class="text-gray-600 dark:text-gray-400 text-base leading-relaxed mb-8 bg-blue-50 dark:bg-blue-900/20 border-l-4 border-primary px-4 py-3 rounded-r-lg">{{ article.excerpt }}</p>

      {# Body content #}
      <div class="prose prose-gray dark:prose-invert max-w-none
                  prose-headings:font-bold prose-headings:text-gray-900 dark:prose-headings:text-white
                  prose-h2:text-xl prose-h2:mt-8 prose-h2:mb-4
                  prose-h3:text-lg prose-h3:mt-6 prose-h3:mb-3
                  prose-p:text-gray-700 dark:prose-p:text-gray-300 prose-p:leading-relaxed
                  prose-a:text-primary prose-a:no-underline hover:prose-a:underline
                  prose-table:text-sm prose-thead:bg-gray-100 dark:prose-thead:bg-gray-800
                  prose-th:px-4 prose-th:py-2 prose-th:font-semibold
                  prose-td:px-4 prose-td:py-2 prose-td:border prose-td:border-gray-200 dark:prose-td:border-gray-700
                  prose-code:text-primary prose-code:bg-primary/10 prose-code:px-1 prose-code:rounded prose-code:text-sm
                  prose-li:text-gray-700 dark:prose-li:text-gray-300">
        {{ body_html | safe }}
      </div>

      {# Disclaimer #}
      <div class="mt-10 p-4 bg-amber-50 dark:bg-amber-900/10 border border-amber-200 dark:border-amber-800 rounded-xl text-sm text-amber-800 dark:text-amber-300">
        <strong>Disclaimer:</strong> This article provides general information only and is not tax or CA advice. Tax laws change frequently. Consult a Chartered Accountant for advice specific to your situation. Information based on Income Tax Act as updated for FY {{ article.fy_applicable }}.
      </div>

      {# WhatsApp share #}
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <span class="text-sm text-gray-500 dark:text-gray-400 font-medium">Share:</span>
        <a href="https://wa.me/?text={{ article.title | urlencode }}%20{{ canonical_url | urlencode }}"
           target="_blank" rel="noopener"
           class="inline-flex items-center gap-2 bg-green-500 hover:bg-green-600 text-white text-sm font-medium px-4 py-2 rounded-lg transition-colors">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Share on WhatsApp
        </a>
        <a href="https://twitter.com/intent/tweet?text={{ article.title | urlencode }}&url={{ canonical_url | urlencode }}"
           target="_blank" rel="noopener"
           class="inline-flex items-center gap-2 bg-sky-500 hover:bg-sky-600 text-white text-sm font-medium px-4 py-2 rounded-lg transition-colors">
          Share on X
        </a>
      </div>

      {# Helpful? #}
      <div class="mt-8 p-6 bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 text-center"
           id="helpful-section">
        <p class="text-gray-700 dark:text-gray-300 font-medium mb-4">Was this article helpful?</p>
        <div class="flex justify-center gap-3">
          <button hx-post="{{ url('blog:helpful', args=[article.slug]) }}"
                  hx-vals='{"vote": "yes"}'
                  hx-target="#helpful-section"
                  hx-swap="innerHTML"
                  class="inline-flex items-center gap-2 px-5 py-2 bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 hover:bg-green-200 dark:hover:bg-green-900/50 rounded-lg font-medium text-sm transition-colors">
            {{ csrf_input }}
            👍 Yes ({{ article.helpful_yes }})
          </button>
          <button hx-post="{{ url('blog:helpful', args=[article.slug]) }}"
                  hx-vals='{"vote": "no"}'
                  hx-target="#helpful-section"
                  hx-swap="innerHTML"
                  class="inline-flex items-center gap-2 px-5 py-2 bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-400 hover:bg-red-200 dark:hover:bg-red-900/50 rounded-lg font-medium text-sm transition-colors">
            {{ csrf_input }}
            👎 No ({{ article.helpful_no }})
          </button>
        </div>
      </div>

      {# Author bio #}
      {% if article.author %}
      <div class="mt-8 p-6 bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700">
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold text-xl flex-shrink-0">
            {{ article.author.name[0] }}
          </div>
          <div>
            <p class="font-semibold text-gray-900 dark:text-white">{{ article.author.name }}</p>
            <p class="text-sm text-gray-500 dark:text-gray-400 mb-2">{{ article.author.title }}</p>
            <p class="text-sm text-gray-600 dark:text-gray-300">{{ article.author.bio }}</p>
            {% if article.author.is_ca %}
            <span class="inline-block mt-2 text-xs bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 px-2 py-0.5 rounded">✓ Verified CA</span>
            {% endif %}
          </div>
        </div>
      </div>
      {% endif %}

    </article>

    {# ── Sidebar ──────────────────────────────────────── #}
    <aside class="lg:col-span-1 space-y-6">

      {# Related Tools #}
      {% if article.related_tools.count() > 0 %}
      <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 p-5">
        <h3 class="font-semibold text-gray-900 dark:text-white text-sm mb-4">Related Calculators</h3>
        <ul class="space-y-3">
          {% for tool in article.related_tools.all() %}
          <li>
            <a href="{{ url('tools:detail', args=[tool.slug]) }}"
               class="flex items-center gap-3 text-sm text-gray-600 dark:text-gray-400 hover:text-primary dark:hover:text-white transition-colors group">
              <span class="text-lg">{{ tool.icon }}</span>
              <span class="group-hover:underline leading-snug">{{ tool.name }}</span>
            </a>
          </li>
          {% endfor %}
        </ul>
      </div>
      {% endif %}

      {# CA Lead CTA #}
      <div class="bg-primary/5 dark:bg-primary/10 border border-primary/20 rounded-2xl p-5">
        <p class="text-sm font-semibold text-gray-900 dark:text-white mb-1">Need CA help?</p>
        <p class="text-xs text-gray-500 dark:text-gray-400 mb-3">Get expert advice from a Chartered Accountant. Free first call.</p>
        <form hx-post="{{ url('newsletter:ca_lead') }}"
              hx-target="#article-ca-response"
              hx-swap="innerHTML"
              class="space-y-2">
          {{ csrf_input }}
          <input type="hidden" name="source_tool" value="blog-{{ article.slug }}">
          <input type="text" name="name" placeholder="Your name" required
                 class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-600 dark:bg-gray-700 text-xs focus:outline-none focus:ring-2 focus:ring-primary">
          <input type="tel" name="phone" placeholder="Phone number" required inputmode="numeric"
                 class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-600 dark:bg-gray-700 text-xs focus:outline-none focus:ring-2 focus:ring-primary">
          <select name="query_type"
                  class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-600 dark:bg-gray-700 text-xs focus:outline-none focus:ring-2 focus:ring-primary">
            <option value="itr">ITR Filing</option>
            <option value="planning">Tax Planning</option>
            <option value="gst">GST Help</option>
            <option value="other">Other</option>
          </select>
          <button type="submit"
                  class="w-full bg-primary hover:bg-blue-700 text-white font-medium py-2 rounded-lg text-xs transition-colors">
            Request CA Callback →
          </button>
        </form>
        <div id="article-ca-response" class="mt-2"></div>
        <p class="text-xs text-gray-400 mt-2 text-center">CA calls within 24 hours. No spam.</p>
      </div>

      {# Newsletter #}
      <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-2xl p-5">
        <p class="text-sm font-semibold text-gray-900 dark:text-white mb-1">Tax Saver Weekly</p>
        <p class="text-xs text-gray-500 dark:text-gray-400 mb-3">Tips, deadlines, and tax-saving ideas — every Monday.</p>
        <form hx-post="{{ url('newsletter:subscribe') }}"
              hx-target="#article-newsletter"
              hx-swap="innerHTML"
              class="space-y-2">
          {{ csrf_input }}
          <input type="email" name="email" required placeholder="your@email.com"
                 class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-600 dark:bg-gray-700 text-xs focus:outline-none focus:ring-2 focus:ring-primary">
          <button type="submit"
                  class="w-full bg-accent hover:bg-orange-600 text-white font-medium py-2 rounded-lg text-xs transition-colors">
            Subscribe Free →
          </button>
        </form>
        <div id="article-newsletter" class="mt-2"></div>
      </div>

      {# AdSense sidebar slot #}
      {% include 'components/adsense.jinja' with context %}

      {# Related Articles #}
      {% if related_articles %}
      <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 p-5">
        <h3 class="font-semibold text-gray-900 dark:text-white text-sm mb-4">Related Articles</h3>
        <ul class="space-y-4">
          {% for rel in related_articles %}
          <li>
            <a href="{{ rel.get_absolute_url() }}" class="group">
              {% if rel.category %}
              <span class="text-xs text-primary">{{ rel.category.name }}</span>
              {% endif %}
              <p class="text-sm text-gray-700 dark:text-gray-300 group-hover:text-primary transition-colors leading-snug mt-0.5">{{ rel.title }}</p>
              <p class="text-xs text-gray-400 mt-1">{{ rel.reading_time }} min read</p>
            </a>
          </li>
          {% endfor %}
        </ul>
      </div>
      {% endif %}

      {# Tags #}
      {% if article.tag_list %}
      <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 p-5">
        <h3 class="font-semibold text-gray-900 dark:text-white text-sm mb-3">Tags</h3>
        <div class="flex flex-wrap gap-2">
          {% for tag in article.tag_list %}
          <span class="text-xs bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 px-2 py-1 rounded">{{ tag }}</span>
          {% endfor %}
        </div>
      </div>
      {% endif %}

    </aside>
  </div>

</div>
{% endblock %}
