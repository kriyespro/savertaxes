{% extends "control/base_control.jinja" %}
{% block content %}
<h1 class="text-2xl font-bold text-gray-900 mb-6">CA Leads</h1>
<div class="bg-white rounded-xl border border-gray-200">
  <table class="w-full text-sm">
    <thead class="bg-gray-50">
      <tr class="text-left text-xs text-gray-500 uppercase tracking-wide">
        <th class="px-4 py-3">Name</th>
        <th class="px-4 py-3">Phone</th>
        <th class="px-4 py-3">City</th>
        <th class="px-4 py-3">Type</th>
        <th class="px-4 py-3">Source</th>
        <th class="px-4 py-3">Status</th>
        <th class="px-4 py-3">Date</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-50">
      {% for lead in leads %}
      <tr class="hover:bg-gray-50">
        <td class="px-4 py-3 font-medium text-gray-900">{{ lead.name }}</td>
        <td class="px-4 py-3 text-gray-700">{{ lead.phone }}</td>
        <td class="px-4 py-3 text-gray-500">{{ lead.city or '—' }}</td>
        <td class="px-4 py-3"><span class="text-xs bg-blue-50 text-blue-700 px-2 py-0.5 rounded">{{ lead.get_query_type_display() }}</span></td>
        <td class="px-4 py-3 text-gray-400 text-xs">{{ lead.source_tool or '—' }}</td>
        <td class="px-4 py-3"><span class="text-xs {% if lead.status == 'new' %}bg-amber-100 text-amber-700{% elif lead.status == 'converted' %}bg-green-100 text-green-700{% else %}bg-gray-100 text-gray-600{% endif %} px-2 py-0.5 rounded">{{ lead.status }}</span></td>
        <td class="px-4 py-3 text-gray-400 text-xs">{{ lead.created_at.strftime('%d %b %Y') }}</td>
      </tr>
      {% else %}
      <tr><td colspan="7" class="px-4 py-8 text-center text-gray-400">No leads yet.</td></tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endblock %}
