<!DOCTYPE html>
<html lang="en" class="h-full" x-data="{ sidebarOpen: true }">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}Mission Control — TaxSaver{% endblock %}</title>
  <link rel="stylesheet" href="{{ static('css/output.css') }}">
  <script defer src="{{ static('js/alpine.min.js') }}"></script>
</head>
<body class="h-full bg-gray-100 font-inter">
<div class="flex h-full">
  {# Sidebar #}
  <div class="w-64 bg-gray-900 text-gray-300 flex flex-col flex-shrink-0" x-show="sidebarOpen">
    <div class="px-6 py-4 border-b border-gray-800">
      <p class="text-white font-bold">Mission Control</p>
      <p class="text-xs text-gray-500">TaxSaver India</p>
    </div>
    <nav class="flex-1 px-4 py-4 space-y-1">
      <a href="{{ url('control:dashboard') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm hover:bg-gray-800 hover:text-white transition-colors">📊 Dashboard</a>
      <a href="{{ url('control:users') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm hover:bg-gray-800 hover:text-white transition-colors">👤 Users</a>
      <a href="{{ url('control:leads') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm hover:bg-gray-800 hover:text-white transition-colors">📋 CA Leads</a>
      <a href="{{ url('admin:index') }}" class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm hover:bg-gray-800 hover:text-white transition-colors">⚙️ Django Admin</a>
    </nav>
    <div class="px-4 py-4 border-t border-gray-800">
      <form method="post" action="{{ url('users:logout') }}">
        {{ csrf_input }}
        <button type="submit" class="text-xs text-gray-500 hover:text-white transition-colors">Sign out</button>
      </form>
    </div>
  </div>
  {# Main #}
  <div class="flex-1 flex flex-col overflow-hidden">
    <header class="bg-white border-b border-gray-200 px-6 py-3 flex items-center justify-between">
      <button @click="sidebarOpen = !sidebarOpen" class="text-gray-500 hover:text-gray-700">☰</button>
      <p class="text-sm text-gray-500">{{ request.user.username }}</p>
    </header>
    <main class="flex-1 overflow-y-auto p-6">
      {% block content %}{% endblock %}
    </main>
  </div>
</div>
<script src="{{ static('js/htmx.min.js') }}"></script>
</body>
</html>
