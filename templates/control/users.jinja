{% extends "control/base_control.jinja" %}
{% block content %}
<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-gray-900">Users</h1>
</div>
<div class="bg-white rounded-xl border border-gray-200">
  <div class="p-4 border-b border-gray-100">
    <input type="search" name="q" placeholder="Search by email or username..."
           class="w-full max-w-sm px-4 py-2 rounded-lg border border-gray-300 text-sm focus:outline-none focus:ring-2 focus:ring-primary"
           hx-get="{{ url('control:users') }}"
           hx-trigger="keyup changed delay:300ms"
           hx-target="#user-table-body"
           hx-swap="innerHTML">
  </div>
  <table class="w-full text-sm">
    <thead class="bg-gray-50">
      <tr class="text-left text-xs text-gray-500 uppercase tracking-wide">
        <th class="px-4 py-3">User</th>
        <th class="px-4 py-3">Email</th>
        <th class="px-4 py-3">Joined</th>
        <th class="px-4 py-3">Staff</th>
      </tr>
    </thead>
    <tbody id="user-table-body" class="divide-y divide-gray-50">
      {% for user in users %}
      <tr class="hover:bg-gray-50">
        <td class="px-4 py-3 font-medium text-gray-900">{{ user.username }}</td>
        <td class="px-4 py-3 text-gray-500">{{ user.email }}</td>
        <td class="px-4 py-3 text-gray-500">{{ user.date_joined.strftime('%d %b %Y') }}</td>
        <td class="px-4 py-3">{% if user.is_staff %}<span class="text-xs bg-blue-100 text-blue-700 px-2 py-0.5 rounded">Staff</span>{% endif %}</td>
      </tr>
      {% else %}
      <tr><td colspan="4" class="px-4 py-8 text-center text-gray-400">No users found.</td></tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endblock %}
