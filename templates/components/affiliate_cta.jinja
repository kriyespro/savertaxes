{% if affiliate %}
{% set badge_colors = {
  'green':  'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-300',
  'blue':   'bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-300',
  'purple': 'bg-purple-100 text-purple-800 dark:bg-purple-900/30 dark:text-purple-300',
  'amber':  'bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-300',
  'teal':   'bg-teal-100 text-teal-800 dark:bg-teal-900/30 dark:text-teal-300',
} %}
<div class="mt-6 p-4 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl">
  <div class="flex items-start justify-between gap-3">
    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-2 mb-1">
        <span class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Recommended</span>
        {% if affiliate.badge %}
        <span class="text-xs font-medium px-2 py-0.5 rounded-full {{ badge_colors.get(affiliate.badge_color, badge_colors['green']) }}">
          {{ affiliate.badge }}
        </span>
        {% endif %}
      </div>
      <p class="font-semibold text-gray-900 dark:text-white text-sm">{{ affiliate.name }}</p>
      <p class="text-gray-600 dark:text-gray-400 text-xs mt-0.5">{{ affiliate.cta }}</p>
    </div>
    <a href="{{ affiliate.url }}"
       target="_blank" rel="noopener sponsored"
       onclick="gtag && gtag('event', 'affiliate_click', {affiliate: '{{ affiliate.name }}', tool: '{{ slug | default('') }}'})"
       class="flex-shrink-0 bg-accent hover:bg-orange-600 text-white text-xs font-semibold px-4 py-2 rounded-lg transition-colors whitespace-nowrap">
      Get Started →
    </a>
  </div>
  <p class="text-xs text-gray-400 dark:text-gray-500 mt-2">Sponsored · We may earn a commission at no extra cost to you.</p>
</div>
{% endif %}
