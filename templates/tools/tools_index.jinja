{% extends "base.jinja" %}

{% block content %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-2">Free Tax Calculators — India</h1>
  <p class="text-gray-600 dark:text-gray-400 mb-8">50+ free income tax, GST, HRA and capital gains calculators. Updated for FY {{ CURRENT_FY }}.</p>

  {# Category filter tabs #}
  <div class="flex flex-wrap gap-2 mb-8">
    <a href="{{ url('tools:index') }}"
       class="px-4 py-2 rounded-full text-sm font-medium transition-colors {% if active_category == 'all' %}bg-primary text-white{% else %}bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 hover:bg-gray-200{% endif %}">
      All Tools
    </a>
    {% for cat in [('regime', 'Regime Comparison'), ('income', 'Income Tax'), ('deductions', 'Deductions'), ('freelancer', 'Freelancer'), ('gst', 'GST'), ('investment', 'Investments'), ('retirement', 'Retirement')] %}
    <a href="{{ url('tools:index') }}?category={{ cat[0] }}"
       class="px-4 py-2 rounded-full text-sm font-medium transition-colors {% if active_category == cat[0] %}bg-primary text-white{% else %}bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 hover:bg-gray-200{% endif %}">
      {{ cat[1] }}
    </a>
    {% endfor %}
  </div>

  {# Tools grid #}
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
    {% for tool in tools %}
    <a href="{{ tool.get_absolute_url() }}"
       class="group bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 hover:border-primary hover:shadow-lg transition-all p-6">
      <div class="flex items-start justify-between mb-3">
        <span class="inline-block text-xs font-medium text-primary bg-primary/10 px-2 py-1 rounded">{{ tool.get_category_display() }}</span>
        <span class="text-xs text-gray-400">FY {{ tool.fy_applicable }}</span>
      </div>
      <h2 class="font-semibold text-gray-900 dark:text-white text-sm leading-snug mb-2 group-hover:text-primary transition-colors">{{ tool.name }}</h2>
      <p class="text-xs text-gray-500 dark:text-gray-400 line-clamp-2">{{ tool.short_desc }}</p>
      <div class="mt-4 flex items-center justify-between">
        {% if tool.rating_total > 0 %}
        <span class="text-xs text-gray-400">👍 {{ tool.rating_pct }}%</span>
        {% else %}
        <span></span>
        {% endif %}
        <span class="text-xs text-primary font-medium group-hover:underline">Calculate →</span>
      </div>
    </a>
    {% else %}
    <div class="col-span-3 py-16 text-center">
      <p class="text-gray-400 text-lg mb-2">No tools yet.</p>
      <p class="text-gray-400 text-sm">Add tools via the <a href="/sd/" class="text-primary underline">admin panel</a>.</p>
    </div>
    {% endfor %}
  </div>
</div>
{% endblock %}
