{# T19 — Freelancer Tax Planner #}
<div class="space-y-5">
  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Annual Gross Receipts</label>
    <div class="relative"><span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 font-medium">₹</span>
      <input type="number" name="gross_receipts" placeholder="e.g. 2000000" min="0" inputmode="numeric" class="w-full pl-8 pr-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
    </div>
    <p class="text-xs text-gray-400 mt-1">Total invoiced amount (including GST if applicable). 44ADA limit: ₹75L.</p>
  </div>
  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Tax Regime</label>
    <select name="regime" class="w-full px-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
      <option value="new">New Regime (simpler, no deductions)</option>
      <option value="old">Old Regime (80C, 80D, NPS deductions)</option>
    </select>
  </div>
  <div x-data="{ showDed: false }">
    <button type="button" @click="showDed = !showDed" class="flex items-center gap-2 text-sm font-medium text-primary hover:underline">
      <svg class="w-4 h-4 transition-transform" :class="{'rotate-90':showDed}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      Add deductions (Old Regime)
    </button>
    <div x-show="showDed" x-transition class="mt-3 space-y-3 p-4 bg-blue-50 dark:bg-blue-900/10 rounded-xl border border-blue-100 dark:border-blue-800">
      {% for name, label, ph in [('sec_80c','80C (PPF/ELSS/LIC)','150000'),('sec_80d','80D Health Insurance','25000'),('nps_extra','NPS Extra (80CCD 1B)','50000')] %}
      <div><label class="text-xs font-medium text-gray-600 dark:text-gray-400 mb-1 block">{{ label }}</label>
        <div class="relative"><span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs">₹</span>
          <input type="number" name="{{ name }}" placeholder="{{ ph }}" min="0" inputmode="numeric" class="w-full pl-7 pr-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</div>
