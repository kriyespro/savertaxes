{# T25 — PPF Maturity Calculator #}
<div class="space-y-5">
  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Annual PPF Investment</label>
    <div class="relative"><span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 font-medium">₹</span>
      <input type="number" name="annual_investment" placeholder="e.g. 150000" min="500" max="150000" inputmode="numeric" class="w-full pl-8 pr-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
    </div>
    <p class="text-xs text-gray-400 mt-1">Min ₹500/year. Max ₹1,50,000/year.</p>
  </div>
  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Investment Period (Years)</label>
    <select name="years" class="w-full px-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
      <option value="15" selected>15 years (minimum/maturity)</option>
      <option value="20">20 years (1 extension)</option>
      <option value="25">25 years (2 extensions)</option>
      <option value="30">30 years (3 extensions)</option>
    </select>
  </div>
  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">PPF Interest Rate (%)</label>
    <input type="number" name="ppf_rate" placeholder="7.1" min="1" max="15" step="0.1" inputmode="decimal" class="w-full px-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
    <p class="text-xs text-gray-400 mt-1">Current rate: 7.1% p.a. (Q1 FY 2025-26)</p>
  </div>
</div>
