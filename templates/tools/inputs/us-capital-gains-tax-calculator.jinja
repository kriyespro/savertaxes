<div class="space-y-4">
  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Other Ordinary Income (W-2 salary, etc.)</label>
    <div class="relative">
      <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 font-semibold">$</span>
      <input type="number" name="total_income" min="0" step="1000" value="60000" inputmode="numeric"
             class="w-full pl-7 pr-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
    </div>
    <p class="text-xs text-gray-400 mt-1">After standard deduction (approximately)</p>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Short-Term Capital Gains <span class="text-xs text-gray-400">(held &lt; 1 year)</span></label>
    <div class="relative">
      <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 font-semibold">$</span>
      <input type="number" name="short_term_gain" min="0" step="100" value="0" inputmode="numeric"
             class="w-full pl-7 pr-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
    </div>
    <p class="text-xs text-red-500 mt-1">Taxed at ordinary income rates (10%–37%)</p>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Long-Term Capital Gains <span class="text-xs text-gray-400">(held ≥ 1 year)</span></label>
    <div class="relative">
      <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 font-semibold">$</span>
      <input type="number" name="long_term_gain" min="0" step="100" value="10000" inputmode="numeric"
             class="w-full pl-7 pr-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
    </div>
    <p class="text-xs text-green-600 dark:text-green-400 mt-1">Preferential rates: 0% / 15% / 20%</p>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Filing Status</label>
    <select name="filing_status" class="w-full px-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
      <option value="single">Single</option>
      <option value="married_jointly">Married Filing Jointly</option>
      <option value="married_separately">Married Filing Separately</option>
      <option value="head_of_household">Head of Household</option>
    </select>
  </div>
</div>
