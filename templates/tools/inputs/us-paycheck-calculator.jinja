<div class="space-y-4">
  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Annual Salary</label>
    <div class="relative">
      <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 font-semibold">$</span>
      <input type="number" name="annual_salary" min="0" step="1000" value="75000" inputmode="numeric"
             class="w-full pl-7 pr-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
    </div>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Pay Frequency</label>
    <select name="pay_frequency" class="w-full px-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
      <option value="biweekly">Biweekly (every 2 weeks — 26 paychecks/yr)</option>
      <option value="semimonthly">Semi-monthly (twice a month — 24/yr)</option>
      <option value="monthly">Monthly (12/yr)</option>
      <option value="weekly">Weekly (52/yr)</option>
    </select>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Filing Status (W-4)</label>
    <select name="filing_status" class="w-full px-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
      <option value="single">Single</option>
      <option value="married_jointly">Married Filing Jointly</option>
      <option value="head_of_household">Head of Household</option>
    </select>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">State Income Tax Rate <span class="text-gray-400">(optional)</span></label>
    <div class="relative">
      <input type="number" name="state_tax_rate" min="0" max="15" step="0.1" value="0" inputmode="decimal"
             class="w-full pr-8 pl-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
      <span class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 font-semibold">%</span>
    </div>
    <p class="text-xs text-gray-400 mt-1">CA: 9.3% avg · NY: 6.85% · TX/FL/WA: 0% · IL: 4.95%</p>
  </div>

  <details class="bg-gray-50 dark:bg-gray-700 rounded-xl p-3">
    <summary class="text-sm font-medium text-gray-700 dark:text-gray-300 cursor-pointer">Pre-tax deductions (optional)</summary>
    <div class="space-y-3 mt-3">
      <div>
        <label class="block text-xs text-gray-500 mb-1">401(k) contribution (annual)</label>
        <div class="relative">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm">$</span>
          <input type="number" name="pre_tax_401k" min="0" max="23500" step="500" value="0" inputmode="numeric"
                 class="w-full pl-7 pr-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 dark:bg-gray-600 text-sm">
        </div>
      </div>
      <div>
        <label class="block text-xs text-gray-500 mb-1">HSA contribution (annual)</label>
        <div class="relative">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm">$</span>
          <input type="number" name="pre_tax_hsa" min="0" max="8550" step="100" value="0" inputmode="numeric"
                 class="w-full pl-7 pr-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 dark:bg-gray-600 text-sm">
        </div>
      </div>
      <div>
        <label class="block text-xs text-gray-500 mb-1">Medical/dental premiums (annual)</label>
        <div class="relative">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm">$</span>
          <input type="number" name="pre_tax_medical" min="0" step="100" value="0" inputmode="numeric"
                 class="w-full pl-7 pr-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 dark:bg-gray-600 text-sm">
        </div>
      </div>
    </div>
  </details>
</div>
