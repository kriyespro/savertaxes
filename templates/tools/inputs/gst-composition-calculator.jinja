{# T31 — GST Composition Scheme #}
<div class="space-y-5">
  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Annual Turnover</label>
    <div class="relative"><span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 font-medium">₹</span>
      <input type="number" name="annual_turnover" placeholder="e.g. 5000000" min="0" inputmode="numeric" class="w-full pl-8 pr-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
    </div>
  </div>
  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Business Type</label>
    <select name="business_type" class="w-full px-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
      <option value="trader">Trader / Retailer (1% of turnover, limit ₹1.5Cr)</option>
      <option value="manufacturer">Manufacturer (1% of turnover, limit ₹1.5Cr)</option>
      <option value="restaurant">Restaurant (5% of turnover, limit ₹1.5Cr)</option>
      <option value="service">Service Provider (6% of turnover, limit ₹50L)</option>
    </select>
  </div>
</div>
