{# T11 — Income Tax Refund Estimator #}
<div class="space-y-5">

  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Annual Gross Income</label>
    <div class="relative">
      <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 font-medium">₹</span>
      <input type="number" name="income" placeholder="e.g. 1200000" min="0" inputmode="numeric"
             class="w-full pl-8 pr-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
    </div>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Total TDS Deducted (Full Year)</label>
    <div class="relative">
      <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 font-medium">₹</span>
      <input type="number" name="tds_deducted" placeholder="e.g. 50000" min="0" inputmode="numeric"
             class="w-full pl-8 pr-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
    </div>
    <p class="text-xs text-gray-400 mt-1">From Form 16 / Form 26AS — total TDS by employer + banks</p>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Advance Tax Paid (if any)</label>
    <div class="relative">
      <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 font-medium">₹</span>
      <input type="number" name="advance_tax_paid" placeholder="0" min="0" inputmode="numeric"
             class="w-full pl-8 pr-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
    </div>
    <p class="text-xs text-gray-400 mt-1">Challan 280 payments made during the year</p>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Tax Regime</label>
    <select name="regime" class="w-full px-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
      <option value="new">New Regime (default from FY 2023-24)</option>
      <option value="old">Old Regime</option>
    </select>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Age Group</label>
    <select name="age_group" class="w-full px-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
      <option value="below_60">Below 60 years</option>
      <option value="60_to_79">60–79 (Senior Citizen)</option>
      <option value="80_plus">80+ (Super Senior)</option>
    </select>
  </div>

  <div x-data="{ showDed: false }">
    <button type="button" @click="showDed = !showDed"
            class="flex items-center gap-2 text-sm font-medium text-primary dark:text-blue-400 hover:underline">
      <svg class="w-4 h-4 transition-transform" :class="{ 'rotate-90': showDed }" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
      <span x-text="showDed ? 'Hide deductions' : 'Add deductions (Old Regime)'"></span>
    </button>
    <div x-show="showDed" x-transition class="mt-4 space-y-3 p-4 bg-blue-50 dark:bg-blue-900/10 rounded-xl border border-blue-100 dark:border-blue-800">
      {% for name, label, ph in [('sec_80c','80C','150000'),('sec_80d_self','80D self','25000'),('hra_exemption','HRA Exemption','0'),('home_loan_interest','Home Loan Interest (24b)','200000'),('nps_extra','NPS Extra (80CCD 1B)','50000')] %}
      <div>
        <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1">{{ label }}</label>
        <div class="relative">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs">₹</span>
          <input type="number" name="{{ name }}" placeholder="{{ ph }}" min="0" inputmode="numeric"
                 class="w-full pl-7 pr-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</div>
