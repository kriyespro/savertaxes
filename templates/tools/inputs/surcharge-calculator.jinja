{# T29 — Surcharge Calculator #}
<div class="space-y-5">
  <div class="p-3 bg-amber-50 dark:bg-amber-900/10 border border-amber-200 dark:border-amber-800 rounded-xl text-xs text-amber-700 dark:text-amber-400">
    Surcharge applies when income exceeds ₹50 lakh. This tool shows exact surcharge amount and effective rate.
  </div>
  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Annual Income</label>
    <div class="relative"><span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 font-medium">₹</span>
      <input type="number" name="income" placeholder="e.g. 7500000" min="0" inputmode="numeric" class="w-full pl-8 pr-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
    </div>
  </div>
  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Tax Regime</label>
    <select name="regime" class="w-full px-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
      <option value="new">New Regime (max surcharge 25%)</option>
      <option value="old">Old Regime (max surcharge 37%)</option>
    </select>
  </div>
</div>
