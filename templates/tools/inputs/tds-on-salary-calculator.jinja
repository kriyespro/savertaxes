{# T08 — TDS on Salary Calculator #}
<div class="space-y-5">

  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Annual Gross Salary</label>
    <div class="relative">
      <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 font-medium">₹</span>
      <input type="number" name="income" placeholder="e.g. 1500000" min="0" inputmode="numeric"
             class="w-full pl-8 pr-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
    </div>
    <p class="text-xs text-gray-400 mt-1">Gross salary after standard deduction, before investment proofs</p>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Tax Regime</label>
    <div class="flex rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden text-sm">
      <label class="flex-1 text-center">
        <input type="radio" name="regime" value="new" class="sr-only" checked>
        <span class="block py-2.5 cursor-pointer tds-regime bg-primary text-white font-medium">New Regime</span>
      </label>
      <label class="flex-1 text-center">
        <input type="radio" name="regime" value="old" class="sr-only">
        <span class="block py-2.5 cursor-pointer tds-regime text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700">Old Regime</span>
      </label>
    </div>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Age Group</label>
    <select name="age_group" class="w-full px-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
      <option value="below_60">Below 60 years</option>
      <option value="60_to_79">60–79 years (Senior Citizen)</option>
      <option value="80_plus">80+ years (Super Senior)</option>
    </select>
  </div>

  <div x-data="{ showDed: false }">
    <button type="button" @click="showDed = !showDed"
            class="flex items-center gap-2 text-sm font-medium text-primary dark:text-blue-400 hover:underline">
      <svg class="w-4 h-4 transition-transform" :class="{ 'rotate-90': showDed }" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
      <span x-text="showDed ? 'Hide deductions (Old Regime)' : 'Add deductions (Old Regime only)'"></span>
    </button>

    <div x-show="showDed" x-transition class="mt-4 space-y-3 p-4 bg-blue-50 dark:bg-blue-900/10 rounded-xl border border-blue-100 dark:border-blue-800">
      {% set fields = [
        ('sec_80c', 'Section 80C', '150000'),
        ('sec_80d_self', 'Section 80D (self)', '25000'),
        ('hra_exemption', 'HRA Exemption', '0'),
        ('home_loan_interest', 'Home Loan Interest (Sec 24b)', '200000'),
        ('nps_extra', 'NPS Extra (80CCD 1B)', '50000'),
      ] %}
      {% for name, label, ph in fields %}
      <div>
        <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1">{{ label }}</label>
        <div class="relative">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs">₹</span>
          <input type="number" name="{{ name }}" placeholder="{{ ph }}" min="0" inputmode="numeric"
                 class="w-full pl-7 pr-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</div>

<script>
document.querySelectorAll('input[name="regime"]').forEach(radio => {
  radio.addEventListener('change', function() {
    document.querySelectorAll('.tds-regime').forEach(el => {
      el.classList.remove('bg-primary', 'text-white', 'font-medium');
      el.classList.add('text-gray-600', 'dark:text-gray-400');
    });
    this.nextElementSibling.classList.add('bg-primary', 'text-white', 'font-medium');
    this.nextElementSibling.classList.remove('text-gray-600', 'dark:text-gray-400');
    htmx.trigger('#tool-form', 'change');
  });
});
</script>
