<div class="space-y-4">
  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Gross Annual Income</label>
    <div class="relative">
      <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 font-semibold">$</span>
      <input type="number" name="gross_income" min="0" max="10000000" step="1000" value="75000"
             inputmode="numeric"
             class="w-full pl-7 pr-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
    </div>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Filing Status</label>
    <select name="filing_status" class="w-full px-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
      <option value="single">Single</option>
      <option value="married_jointly">Married Filing Jointly</option>
      <option value="married_separately">Married Filing Separately</option>
      <option value="head_of_household">Head of Household</option>
    </select>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Deduction Type</label>
    <select name="deduction_type" class="w-full px-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
      <option value="standard">Standard Deduction (2025: $15,000 Single / $30,000 MFJ)</option>
      <option value="itemized">Itemized Deductions</option>
    </select>
  </div>

  <div id="itemized-field" class="hidden">
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Total Itemized Deductions</label>
    <div class="relative">
      <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 font-semibold">$</span>
      <input type="number" name="itemized_deductions" min="0" step="500" value="0"
             inputmode="numeric"
             class="w-full pl-7 pr-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
    </div>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Qualifying Children (for Child Tax Credit)</label>
    <select name="num_children" class="w-full px-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
      <option value="0">0 children</option>
      <option value="1">1 child ($2,000 credit)</option>
      <option value="2">2 children ($4,000 credit)</option>
      <option value="3">3 children ($6,000 credit)</option>
      <option value="4">4+ children</option>
    </select>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Other Credits (Education, EV, etc.)</label>
    <div class="relative">
      <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 font-semibold">$</span>
      <input type="number" name="other_credits" min="0" step="100" value="0"
             inputmode="numeric"
             class="w-full pl-7 pr-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
    </div>
  </div>
</div>

<script>
document.querySelector('[name="deduction_type"]').addEventListener('change', function() {
  document.getElementById('itemized-field').classList.toggle('hidden', this.value !== 'itemized');
  htmx.trigger(document.getElementById('tool-form'), 'change');
});
</script>
