{# T01 — Old vs New Tax Regime Comparison #}

<div class="space-y-5">
  {# Annual Income #}
  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Annual Income (Gross Salary / Total Income)</label>
    <div class="relative">
      <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 font-medium">₹</span>
      <input type="number" name="income" placeholder="e.g. 1200000" min="0" max="100000000"
             inputmode="numeric"
             class="w-full pl-8 pr-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm"
             value="">
    </div>
    <p class="text-xs text-gray-400 mt-1">Before any deductions. For salaried: enter CTC or gross salary.</p>
  </div>

  {# Age Group #}
  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Age Group</label>
    <select name="age_group" class="w-full px-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
      <option value="below_60">Below 60 years</option>
      <option value="60_to_79">60 to 79 years (Senior Citizen)</option>
      <option value="80_plus">80+ years (Super Senior Citizen)</option>
    </select>
    <p class="text-xs text-gray-400 mt-1">Age on 31st March {{ CURRENT_FY.split('-')[1] }}</p>
  </div>

  {# Deductions (Old Regime) #}
  <div x-data="{ showDeductions: false }">
    <button type="button" @click="showDeductions = !showDeductions"
            class="flex items-center gap-2 text-sm font-medium text-primary dark:text-blue-400 hover:underline">
      <svg class="w-4 h-4 transition-transform" :class="{ 'rotate-90': showDeductions }" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
      <span x-text="showDeductions ? 'Hide deductions (Old Regime)' : 'Add deductions to compare Old Regime'"></span>
    </button>
    <p class="text-xs text-gray-400 mt-1">Leave blank if using New Regime only</p>

    <div x-show="showDeductions" x-transition class="mt-4 space-y-4 p-4 bg-blue-50 dark:bg-blue-900/10 rounded-xl border border-blue-100 dark:border-blue-800">
      <p class="text-xs font-semibold text-blue-700 dark:text-blue-400 uppercase tracking-wide">Old Regime Deductions</p>

      {% set deduction_fields = [
        ('sec_80c', 'Section 80C (PPF, ELSS, LIC, EPF...)', '150000', 'Max ₹1,50,000'),
        ('sec_80d_self', 'Section 80D — Self & Family health insurance', '25000', 'Max ₹25,000'),
        ('sec_80d_parents', 'Section 80D — Parents health insurance', '50000', 'Max ₹50,000 (senior citizen)'),
        ('hra_exemption', 'HRA Exemption (use HRA calculator)', '0', 'From HRA exemption calculator'),
        ('home_loan_interest', 'Home Loan Interest (Sec 24b)', '200000', 'Max ₹2,00,000'),
        ('nps_extra', 'NPS Extra (Sec 80CCD 1B)', '50000', 'Max ₹50,000'),
        ('other_deductions', 'Other deductions (80E, 80G, etc.)', '0', 'Sec 80E, 80G, 80TTA...'),
      ] %}

      {% for field_name, label, placeholder, hint in deduction_fields %}
      <div>
        <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1">{{ label }}</label>
        <div class="relative">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs">₹</span>
          <input type="number" name="{{ field_name }}" placeholder="{{ placeholder }}" min="0"
                 inputmode="numeric"
                 class="w-full pl-7 pr-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
        </div>
        <p class="text-xs text-gray-400 mt-0.5">{{ hint }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</div>
