{# T18 — 44AD Business Presumptive Tax #}
<div class="space-y-5">
  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Annual Gross Turnover</label>
    <div class="relative"><span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 font-medium">₹</span>
      <input type="number" name="gross_turnover" placeholder="e.g. 5000000" min="0" max="30000000" inputmode="numeric" class="w-full pl-8 pr-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
    </div>
    <p class="text-xs text-gray-400 mt-1">44AD limit: ₹3 crore. Above this, actual books required.</p>
  </div>
  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Transaction Type</label>
    <select name="is_digital" class="w-full px-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
      <option value="false">Cash / Mixed (8% of turnover)</option>
      <option value="true">Fully Digital / Cheque / UPI (6% of turnover)</option>
    </select>
    <p class="text-xs text-gray-400 mt-1">6% rate applies if all receipts & payments are via banking channels.</p>
  </div>
</div>
