{# T07 — Section 80D Health Insurance Deduction #}
<div class="space-y-5">

  <div class="p-4 bg-blue-50 dark:bg-blue-900/10 rounded-xl border border-blue-100 dark:border-blue-800">
    <p class="text-xs font-semibold text-blue-700 dark:text-blue-400 uppercase tracking-wide mb-3">Self & Family</p>

    <div class="space-y-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Annual Premium (Self + Spouse + Children)</label>
        <div class="relative">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs">₹</span>
          <input type="number" name="premium_self" placeholder="e.g. 18000" min="0" inputmode="numeric"
                 class="w-full pl-7 pr-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
        </div>
      </div>

      <div class="flex items-center gap-3">
        <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300 cursor-pointer">
          <input type="checkbox" name="senior_self" value="true"
                 class="rounded border-gray-300 text-primary focus:ring-primary"
                 onchange="htmx.trigger('#tool-form', 'change')">
          Any member is 60+ (senior citizen)
        </label>
      </div>
      <p class="text-xs text-gray-400">Senior citizen: limit ₹50,000 | Others: limit ₹25,000</p>

      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Preventive Health Checkup (Self)</label>
        <div class="relative">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs">₹</span>
          <input type="number" name="preventive_self" placeholder="e.g. 3000" min="0" max="5000" inputmode="numeric"
                 class="w-full pl-7 pr-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
        </div>
        <p class="text-xs text-gray-400 mt-0.5">Included within self+family limit (max ₹5,000)</p>
      </div>
    </div>
  </div>

  <div class="p-4 bg-green-50 dark:bg-green-900/10 rounded-xl border border-green-100 dark:border-green-800">
    <p class="text-xs font-semibold text-green-700 dark:text-green-400 uppercase tracking-wide mb-3">Parents</p>

    <div class="space-y-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Annual Premium (Parents)</label>
        <div class="relative">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs">₹</span>
          <input type="number" name="premium_parents" placeholder="e.g. 40000" min="0" inputmode="numeric"
                 class="w-full pl-7 pr-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
        </div>
      </div>

      <div>
        <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300 cursor-pointer">
          <input type="checkbox" name="senior_parents" value="true"
                 class="rounded border-gray-300 text-primary focus:ring-primary"
                 onchange="htmx.trigger('#tool-form', 'change')">
          Parents are 60+ (senior citizen)
        </label>
        <p class="text-xs text-gray-400 mt-1">Senior parent limit: ₹50,000 | Others: ₹25,000</p>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Preventive Health Checkup (Parents)</label>
        <div class="relative">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs">₹</span>
          <input type="number" name="preventive_parents" placeholder="e.g. 2000" min="0" max="5000" inputmode="numeric"
                 class="w-full pl-7 pr-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
        </div>
      </div>
    </div>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Your Tax Bracket</label>
    <select name="marginal_rate" class="w-full px-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
      <option value="30">30% (Income above ₹10L — old regime / ₹24L — new)</option>
      <option value="20">20% (₹5L–₹10L old regime)</option>
      <option value="5">5% (₹2.5L–₹5L old regime)</option>
    </select>
    <p class="text-xs text-gray-400 mt-1">Used to calculate your tax saving</p>
  </div>
</div>
