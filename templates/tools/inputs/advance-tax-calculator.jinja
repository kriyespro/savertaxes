{# T05 — Advance Tax Calculator #}
<div class="space-y-5">
  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Estimated Annual Tax Liability</label>
    <div class="relative">
      <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 font-medium">₹</span>
      <input type="number" name="annual_tax" placeholder="e.g. 50000" min="0" inputmode="numeric"
             class="w-full pl-8 pr-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
    </div>
    <p class="text-xs text-gray-400 mt-1">Use the Income Tax Calculator above to get this number</p>
  </div>
  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">TDS Already Deducted (Expected for full year)</label>
    <div class="relative">
      <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 font-medium">₹</span>
      <input type="number" name="tds_deducted" placeholder="e.g. 20000" min="0" inputmode="numeric"
             class="w-full pl-8 pr-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
    </div>
    <p class="text-xs text-gray-400 mt-1">From Form 26AS or employer's estimate. Enter 0 if freelancer/business.</p>
  </div>
  <div class="bg-amber-50 dark:bg-amber-900/20 rounded-xl p-4 text-xs text-amber-700 dark:text-amber-400">
    <p class="font-semibold mb-1">Advance Tax Due Dates FY {{ CURRENT_FY }}:</p>
    <ul class="space-y-1">
      <li>15 June — 15% of annual tax</li>
      <li>15 September — 45% of annual tax</li>
      <li>15 December — 75% of annual tax</li>
      <li>15 March — 100% of annual tax</li>
    </ul>
  </div>
</div>
