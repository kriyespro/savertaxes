{# T06 — 80C Investment Planner #}
<div class="space-y-5">
  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Annual Income (Old Regime)</label>
    <div class="relative">
      <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 font-medium">₹</span>
      <input type="number" name="income" placeholder="e.g. 1000000" min="0" inputmode="numeric"
             class="w-full pl-8 pr-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
    </div>
  </div>
  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">80C Investments Already Made This Year</label>
    <div class="relative">
      <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 font-medium">₹</span>
      <input type="number" name="invested" placeholder="e.g. 50000" min="0" max="150000"
             inputmode="numeric"
             class="w-full pl-8 pr-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
    </div>
    <p class="text-xs text-gray-400 mt-1">EPF + LIC + PPF + ELSS etc. already invested in FY {{ CURRENT_FY }}</p>
  </div>
  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Your Tax Slab Rate</label>
    <select name="marginal_rate" class="w-full px-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
      <option value="5">5% slab</option>
      <option value="20">20% slab</option>
      <option value="30" selected>30% slab</option>
    </select>
  </div>
  <div class="bg-green-50 dark:bg-green-900/20 rounded-xl p-3 text-xs text-green-700 dark:text-green-400">
    <p class="font-semibold mb-1">80C Eligible Investments:</p>
    <p>PPF • ELSS (Tax Saving MF) • LIC Premium • EPF (employee share) • Home Loan Principal • Sukanya Samriddhi • 5-Year FD • NSC • SCSS • Tuition Fees</p>
  </div>
</div>
