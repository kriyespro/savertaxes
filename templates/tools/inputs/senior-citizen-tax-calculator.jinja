{# T28 — Senior Citizen Tax Calculator #}
<div class="space-y-5">
  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Age Group</label>
    <select name="age_group" class="w-full px-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
      <option value="60_to_79">60–79 years (Senior Citizen)</option>
      <option value="80_plus">80+ years (Super Senior Citizen)</option>
    </select>
  </div>
  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Annual Income (Pension + all sources)</label>
    <div class="relative"><span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 font-medium">₹</span>
      <input type="number" name="income" placeholder="e.g. 800000" min="0" inputmode="numeric" class="w-full pl-8 pr-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
    </div>
  </div>
  <div class="grid grid-cols-2 gap-4">
    <div>
      <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">FD + RD Interest</label>
      <div class="relative"><span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs">₹</span>
        <input type="number" name="fd_interest" placeholder="e.g. 60000" min="0" inputmode="numeric" class="w-full pl-7 pr-4 py-2.5 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
      </div>
      <p class="text-xs text-gray-400 mt-0.5">80TTB: up to ₹50,000 deduction</p>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Savings Account Interest</label>
      <div class="relative"><span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs">₹</span>
        <input type="number" name="savings_interest" placeholder="0" min="0" inputmode="numeric" class="w-full pl-7 pr-4 py-2.5 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
      </div>
    </div>
  </div>
  <div class="grid grid-cols-2 gap-4">
    <div>
      <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Health Insurance (80D)</label>
      <div class="relative"><span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs">₹</span>
        <input type="number" name="sec_80d" placeholder="50000" min="0" max="50000" inputmode="numeric" class="w-full pl-7 pr-4 py-2.5 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
      </div>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">80C Investments</label>
      <div class="relative"><span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs">₹</span>
        <input type="number" name="sec_80c" placeholder="150000" min="0" max="150000" inputmode="numeric" class="w-full pl-7 pr-4 py-2.5 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
      </div>
    </div>
  </div>
</div>
