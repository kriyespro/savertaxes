{# T23 — ELSS vs PPF vs NPS Comparison #}
<div class="space-y-5">
  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Annual Investment Amount</label>
    <div class="relative"><span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 font-medium">₹</span>
      <input type="number" name="annual_investment" placeholder="50000" min="500" max="150000" inputmode="numeric" class="w-full pl-8 pr-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
    </div>
    <p class="text-xs text-gray-400 mt-1">Same amount invested in all three for fair comparison</p>
  </div>
  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Investment Period (Years)</label>
    <select name="years" class="w-full px-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
      <option value="5">5 years</option><option value="10">10 years</option>
      <option value="15" selected>15 years (PPF minimum)</option><option value="20">20 years</option><option value="25">25 years</option>
    </select>
  </div>
  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Your Tax Bracket</label>
    <select name="marginal_rate" class="w-full px-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary text-sm">
      <option value="30">30% slab</option><option value="20">20% slab</option><option value="5">5% slab</option>
    </select>
  </div>
</div>
