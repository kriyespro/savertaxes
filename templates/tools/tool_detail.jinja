{% extends "base.jinja" %}

{% block extra_scripts %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
{% endblock %}

{% block schema %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "{{ tool.name }}",
  "description": "{{ tool.short_desc }}",
  "url": "{{ canonical_url }}",
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "Any",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "INR" }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ request.scheme }}://{{ request.get_host() }}/" },
    { "@type": "ListItem", "position": 2, "name": "Tools", "item": "{{ request.scheme }}://{{ request.get_host() }}/tools/" },
    { "@type": "ListItem", "position": 3, "name": "{{ tool.name }}", "item": "{{ canonical_url }}" }
  ]
}
</script>
{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">

  {# Breadcrumb #}
  <nav class="text-sm text-gray-500 dark:text-gray-400 mb-4" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2">
      <li><a href="{{ url('pages:home') }}" class="hover:text-primary">Home</a></li>
      <li>/</li>
      <li><a href="{{ url('tools:index') }}" class="hover:text-primary">Tools</a></li>
      <li>/</li>
      <li class="text-gray-900 dark:text-white font-medium truncate">{{ tool.name }}</li>
    </ol>
  </nav>

  {# Badge — market-aware #}
  {% if tool.market == 'us' %}
  <div class="inline-flex items-center gap-2 bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 text-blue-700 dark:text-blue-400 text-xs font-medium px-3 py-1 rounded-full mb-4">
    🇺🇸 Tax Year {{ tool.fy_applicable }} · IRS-Accurate
  </div>
  {% else %}
  <div class="inline-flex items-center gap-2 bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 text-green-700 dark:text-green-400 text-xs font-medium px-3 py-1 rounded-full mb-4">
    ✓ Updated for FY {{ tool.fy_applicable }}
  </div>
  {% endif %}

  <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mb-2">{{ tool.name }}</h1>
  <p class="text-gray-600 dark:text-gray-400 mb-8">{{ tool.short_desc }}</p>

  <div class="grid grid-cols-1 lg:grid-cols-5 gap-8">

    {# ── Tool Form (left / top on mobile) ─────────── #}
    <div class="lg:col-span-3">
      <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 p-6">

        {# FY Toggle — India only #}
        {% if tool.market != 'us' %}
        <div class="flex items-center gap-3 mb-6 pb-4 border-b border-gray-100 dark:border-gray-700">
          <span class="text-sm font-medium text-gray-600 dark:text-gray-400">Financial Year:</span>
          <div class="flex rounded-lg border border-gray-200 dark:border-gray-700 overflow-hidden text-sm">
            <button type="button" onclick="setFY('2025-26', this)"
                    class="fy-btn px-3 py-1.5 bg-primary text-white font-medium">FY 2025-26</button>
            <button type="button" onclick="setFY('2024-25', this)"
                    class="fy-btn px-3 py-1.5 text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700">FY 2024-25</button>
          </div>
        </div>
        {% else %}
        <input type="hidden" name="fy" id="fy-input" value="2025">
        {% endif %}

        <form id="tool-form"
              hx-post="{{ url('tools:calculate', args=[tool.slug]) }}"
              hx-headers='{"X-Tool-Market": "{{ tool.market }}"}'
              hx-target="#result-panel"
              hx-swap="innerHTML"
              hx-trigger="change from:input, change from:select"
              hx-indicator="#calc-spinner">
          {{ csrf_input }}
          <input type="hidden" name="fy" id="fy-input" value="2025-26">

          {# Tool-specific inputs #}
          {% include ['tools/inputs/' + tool.slug + '.jinja', 'tools/inputs/default.jinja'] ignore missing %}

          {# Loading indicator #}
          <div id="calc-spinner" class="htmx-indicator flex items-center gap-2 text-sm text-primary mt-4">
            <svg class="animate-spin w-4 h-4" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"/>
            </svg>
            Calculating...
          </div>
        </form>
      </div>
    </div>

    {# ── Result Panel (right / bottom on mobile) ─── #}
    <div class="lg:col-span-2">
      <div id="result-panel" class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 p-6 min-h-[200px]">
        <p class="text-gray-400 dark:text-gray-500 text-sm text-center mt-8">
          Enter your details on the left to see your tax calculation.
        </p>
      </div>

      {# Disclaimer #}
      <p class="text-xs text-gray-400 dark:text-gray-500 mt-3 px-1">
        Results are estimates. Based on Income Tax Act provisions as of FY 2025-26. Consult a CA for tax advice.
      </p>
    </div>
  </div>

  {# ── AdSense slot — below tool grid, above related ───────────── #}
  {% include 'components/adsense.jinja' with context %}

  {# ── Related Tools ──────────────────────────────────────────── #}
  {% if related_tools %}
  <section class="mt-12">
    <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Related Tools</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {% for t in related_tools %}
      <a href="{{ t.get_absolute_url() }}" class="bg-white dark:bg-gray-800 rounded-xl p-4 border border-gray-200 dark:border-gray-700 hover:border-primary hover:shadow-md transition-all">
        <p class="font-medium text-sm text-gray-900 dark:text-white hover:text-primary">{{ t.name }}</p>
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1 line-clamp-2">{{ t.short_desc }}</p>
      </a>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {# ── Expert CTA — market-aware ──────────────────────────────────── #}
  {% if tool.market == 'us' %}
  <div class="mt-8 bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-2xl p-6">
    <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
      <div class="flex-1">
        <h3 class="font-semibold text-gray-900 dark:text-white">Need a CPA or Tax Pro?</h3>
        <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">For complex situations — self-employed, investments, multi-state — a CPA pays for itself.</p>
      </div>
      <a href="https://www.hrblock.com/" target="_blank" rel="noopener sponsored"
         class="bg-primary hover:bg-blue-700 text-white font-medium px-5 py-2.5 rounded-xl text-sm whitespace-nowrap transition-colors">
        Find a Tax Pro →
      </a>
    </div>
  </div>
  {% else %}
  <div class="mt-8 bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-2xl p-6">
    <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
      <div class="flex-1">
        <h3 class="font-semibold text-gray-900 dark:text-white">Need expert tax advice?</h3>
        <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">Connect with a verified Chartered Accountant for personalized tax planning.</p>
      </div>
      <button onclick="document.getElementById('ca-modal').classList.remove('hidden')"
              class="bg-primary hover:bg-blue-700 text-white font-medium px-5 py-2.5 rounded-xl text-sm whitespace-nowrap transition-colors">
        Talk to a CA →
      </button>
    </div>
  </div>
  {% endif %}
</div>

{# ── CA Lead Modal ──────────────────────────────────────────────── #}
<div id="ca-modal" class="hidden fixed inset-0 z-50 flex items-end sm:items-center justify-center bg-black/50 px-4">
  <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 w-full max-w-md shadow-2xl">
    <div class="flex justify-between items-center mb-4">
      <h3 class="font-bold text-gray-900 dark:text-white">Talk to a CA</h3>
      <button onclick="document.getElementById('ca-modal').classList.add('hidden')" class="text-gray-400 hover:text-gray-600">✕</button>
    </div>
    <form hx-post="{{ url('newsletter:ca_lead') }}"
          hx-target="#ca-modal-response"
          hx-swap="innerHTML">
      {{ csrf_input }}
      <input type="hidden" name="source_tool" value="{{ tool.slug }}">
      <div class="space-y-3">
        <input type="text" name="name" placeholder="Your name" required
               class="w-full px-4 py-2.5 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 text-sm focus:outline-none focus:ring-2 focus:ring-primary">
        <input type="tel" name="phone" placeholder="Phone number" required inputmode="numeric"
               class="w-full px-4 py-2.5 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 text-sm focus:outline-none focus:ring-2 focus:ring-primary">
        <input type="text" name="city" placeholder="City (optional)"
               class="w-full px-4 py-2.5 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 text-sm focus:outline-none focus:ring-2 focus:ring-primary">
        <select name="query_type" class="w-full px-4 py-2.5 rounded-xl border border-gray-300 dark:border-gray-600 dark:bg-gray-700 text-sm focus:outline-none focus:ring-2 focus:ring-primary">
          <option value="itr">ITR Filing</option>
          <option value="planning">Tax Planning</option>
          <option value="gst">GST Help</option>
          <option value="business">Business Tax</option>
          <option value="other">Other</option>
        </select>
        <button type="submit" class="w-full bg-primary hover:bg-blue-700 text-white font-semibold py-3 rounded-xl text-sm transition-colors">
          Request CA Callback
        </button>
      </div>
    </form>
    <div id="ca-modal-response" class="mt-3"></div>
    <p class="text-xs text-gray-400 mt-2 text-center">Free consultation. CA will call within 24 hours.</p>
  </div>
</div>

<script>
function setFY(fy, btn) {
  document.getElementById('fy-input').value = fy;
  document.querySelectorAll('.fy-btn').forEach(b => {
    b.classList.remove('bg-primary', 'text-white');
    b.classList.add('text-gray-600');
  });
  btn.classList.add('bg-primary', 'text-white');
  btn.classList.remove('text-gray-600');
  // trigger HTMX recalculation
  htmx.trigger(document.getElementById('tool-form'), 'change');
}
</script>
{% endblock %}
