{% extends "base.jinja" %}

{% block content %}


{# ── Hero ──────────────────────────────────────────────────────────── #}
<section class="bg-gradient-to-br from-primary to-blue-800 text-white py-16 px-4">
  <div class="max-w-4xl mx-auto text-center">
    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight mb-4">
      Find out which tax regime<br class="hidden sm:block"> saves you more money
    </h1>
    <p class="text-blue-100 text-lg mb-8">Free tax calculators, updated for FY {{ CURRENT_FY }}. No signup required.</p>

    {# Primary CTA #}
    <a href="{{ url('tools:detail', args=['old-vs-new-tax-regime']) }}"
       class="inline-flex items-center gap-2 bg-accent hover:bg-green-500 text-white font-semibold px-8 py-4 rounded-xl text-lg transition-colors shadow-lg">
      Old vs New Regime Calculator
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
    </a>

    {# Trust bar #}
    <div class="flex flex-wrap justify-center gap-6 mt-10 text-sm text-blue-200">
      <span>✓ 50+ Free Tools</span>
      <span>✓ Updated Budget 2025</span>
      <span>✓ No Ads on Results</span>
      <span>✓ No Login Required</span>
    </div>
  </div>
</section>

{# ── Tax Deadline Countdown ─────────────────────────────────────────── #}
{% if next_deadline %}
<div class="bg-amber-50 dark:bg-amber-900/20 border-b border-amber-200 dark:border-amber-800 py-3 px-4">
  <p class="text-center text-sm text-amber-800 dark:text-amber-200">
    <strong>{{ next_deadline.label }}</strong> is on {{ next_deadline.date.strftime('%d %B %Y') }} —
    <strong>{{ next_deadline.days_left }} days left</strong>
    <a href="{{ url('tools:detail', args=['advance-tax-calculator']) }}" class="underline ml-2 hover:no-underline">Calculate now →</a>
  </p>
</div>
{% endif %}

{# ── Situation Cards ──────────────────────────────────────────────── #}
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <h2 class="text-2xl font-bold text-center mb-8 text-gray-900 dark:text-white">What's your tax situation?</h2>
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
    {% set situations = [
      {'label': 'Salaried', 'icon': '💼', 'href': url('tools:detail', args=['old-vs-new-tax-regime'])},
      {'label': 'Freelancer', 'icon': '💻', 'href': url('tools:detail', args=['presumptive-tax-44ada'])},
      {'label': 'Business', 'icon': '🏪', 'href': url('gst:index')},
      {'label': 'Investor', 'icon': '📈', 'href': url('tools:detail', args=['capital-gains-calculator'])},
      {'label': 'Senior Citizen', 'icon': '👴', 'href': url('tools:index') + '?category=income'},
    ] %}
    {% for s in situations %}
    <a href="{{ s.href }}" class="flex flex-col items-center p-4 bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 hover:border-primary hover:shadow-md transition-all text-center">
      <span class="text-3xl mb-2">{{ s.icon }}</span>
      <span class="text-sm font-medium text-gray-700 dark:text-gray-300">{{ s.label }}</span>
    </a>
    {% endfor %}
  </div>
</section>

{# ── Popular Tools ─────────────────────────────────────────────────── #}
<section class="bg-gray-100 dark:bg-gray-900 py-12 px-4">
  <div class="max-w-7xl mx-auto">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Popular Tax Tools</h2>
      <a href="{{ url('tools:index') }}" class="text-primary dark:text-blue-400 text-sm font-medium hover:underline">View all tools →</a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {% for tool in featured_tools %}
      <a href="{{ tool.get_absolute_url() }}" class="bg-white dark:bg-gray-800 rounded-xl p-6 border border-gray-200 dark:border-gray-700 hover:border-primary hover:shadow-lg transition-all group">
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 bg-primary/10 dark:bg-primary/20 rounded-xl flex items-center justify-center flex-shrink-0">
            <span class="text-2xl">🧮</span>
          </div>
          <div class="flex-1 min-w-0">
            <h3 class="font-semibold text-gray-900 dark:text-white group-hover:text-primary transition-colors text-sm leading-tight">{{ tool.name }}</h3>
            <p class="text-gray-500 dark:text-gray-400 text-xs mt-1 line-clamp-2">{{ tool.short_desc }}</p>
          </div>
        </div>
        <div class="mt-4 flex items-center justify-between text-xs text-gray-400">
          <span class="bg-gray-100 dark:bg-gray-700 px-2 py-1 rounded">FY {{ tool.fy_applicable }}</span>
          <span class="text-primary group-hover:underline font-medium">Calculate →</span>
        </div>
      </a>
      {% else %}
      <div class="col-span-3 text-center py-12 text-gray-400">
        <p>Tools loading... Add them via <a href="/sd/" class="underline">admin panel</a>.</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

{# ── Latest Articles ──────────────────────────────────────────────── #}
{% if latest_articles %}
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <div class="flex items-center justify-between mb-8">
    <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Latest Tax Guides</h2>
    <a href="{{ url('blog:index') }}" class="text-primary dark:text-blue-400 text-sm font-medium hover:underline">All articles →</a>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {% for article in latest_articles %}
    <a href="{{ article.get_absolute_url() }}" class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 hover:border-primary hover:shadow-md transition-all overflow-hidden group">
      <div class="p-6">
        {% if article.category %}
        <span class="inline-block text-xs font-medium text-primary bg-primary/10 px-2 py-1 rounded mb-3">{{ article.category.name }}</span>
        {% endif %}
        <h3 class="font-semibold text-gray-900 dark:text-white text-sm leading-snug mb-2 group-hover:text-primary transition-colors">{{ article.title }}</h3>
        <p class="text-gray-500 dark:text-gray-400 text-xs line-clamp-2">{{ article.excerpt }}</p>
        <div class="mt-4 flex items-center gap-3 text-xs text-gray-400">
          {% if article.author %}<span>{{ article.author.name }}</span>{% endif %}
          <span>{{ article.reading_time }} min read</span>
        </div>
      </div>
    </a>
    {% endfor %}
  </div>
</section>
{% endif %}

{# ── Newsletter Signup ─────────────────────────────────────────────── #}
<section class="bg-primary py-12 px-4">
  <div class="max-w-2xl mx-auto text-center">
    <h2 class="text-2xl font-bold text-white mb-2">Get the Free Tax-Saving Checklist</h2>
    <p class="text-blue-100 mb-6 text-sm">FY {{ CURRENT_FY }} tax-saving moves — delivered free to your inbox.</p>
    <form hx-post="{{ url('newsletter:subscribe') }}"
          hx-target="#newsletter-response"
          hx-swap="innerHTML"
          class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto">
      {{ csrf_input }}
      <input type="email" name="email" placeholder="Your email address" required
             class="flex-1 px-4 py-3 rounded-xl text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-white">
      <button type="submit" class="bg-accent hover:bg-green-500 text-white font-semibold px-6 py-3 rounded-xl text-sm transition-colors whitespace-nowrap">
        Get Checklist
      </button>
    </form>
    <div id="newsletter-response" class="mt-3 min-h-[24px]"></div>
    <p class="text-blue-200 text-xs mt-3">No spam. Unsubscribe anytime.</p>
  </div>
</section>

{# ── Why TaxSaver ──────────────────────────────────────────────────── #}
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <h2 class="text-2xl font-bold text-center mb-8 text-gray-900 dark:text-white">Why use TaxSaver India?</h2>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    {% for feature in [
      ('⚡', 'Instant Results', 'Calculations update as you type. No submit button.'),
      ('📱', 'Mobile-First', 'Designed for phones. Works perfectly on any screen.'),
      ('✅', 'Always Updated', 'Tax data updated within hours of Budget announcements.'),
      ('🔒', 'Private & Free', 'No account needed. No data stored. 100% free.'),
    ] %}
    <div class="text-center p-6 bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700">
      <div class="text-3xl mb-3">{{ feature[0] }}</div>
      <h3 class="font-semibold text-gray-900 dark:text-white mb-1 text-sm">{{ feature[1] }}</h3>
      <p class="text-gray-500 dark:text-gray-400 text-xs">{{ feature[2] }}</p>
    </div>
    {% endfor %}
  </div>
</section>

{% endblock %}
