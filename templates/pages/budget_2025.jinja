{% extends "base.jinja" %}

{% block schema %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": "Union Budget 2025 — Income Tax Changes Explained",
  "description": "Key income tax changes in Union Budget 2025 for FY 2025-26",
  "datePublished": "2025-02-01",
  "dateModified": "2025-02-01",
  "publisher": {
    "@type": "Organization",
    "name": "TaxSaver India",
    "url": "{{ request.scheme }}://{{ request.get_host() }}"
  }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ request.scheme }}://{{ request.get_host() }}/" },
    { "@type": "ListItem", "position": 2, "name": "Budget 2025", "item": "{{ canonical_url }}" }
  ]
}
</script>
{% endblock %}

{% block content %}
<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

  {# Breadcrumb #}
  <nav class="text-sm text-gray-500 dark:text-gray-400 mb-4">
    <ol class="flex items-center gap-2 flex-wrap">
      <li><a href="{{ url('pages:home') }}" class="hover:text-primary">Home</a></li>
      <li>/</li>
      <li class="font-medium text-gray-900 dark:text-white">Budget 2025</li>
    </ol>
  </nav>

  {# Hero #}
  <div class="bg-gradient-to-r from-amber-50 to-orange-50 dark:from-amber-900/20 dark:to-orange-900/20 border border-amber-200 dark:border-amber-800 rounded-2xl p-6 mb-8">
    <div class="flex items-start gap-4">
      <span class="text-4xl">🏛️</span>
      <div>
        <span class="text-xs font-semibold text-amber-700 dark:text-amber-400 uppercase tracking-wide">Union Budget 2025</span>
        <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mt-1 leading-tight">
          Income Tax Changes in Budget 2025 — Complete Guide
        </h1>
        <p class="text-gray-600 dark:text-gray-400 mt-2 text-sm">
          Applicable from FY 2025-26 (AY 2026-27). Presented by FM Nirmala Sitharaman on February 1, 2025.
        </p>
      </div>
    </div>
  </div>

  {# Key highlight #}
  <div class="bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-2xl p-6 mb-8 text-center">
    <p class="text-sm text-green-700 dark:text-green-400 font-semibold mb-1">Biggest Change</p>
    <p class="text-3xl font-bold text-green-600 dark:text-green-400">₹12 Lakh</p>
    <p class="text-gray-600 dark:text-gray-400 text-sm mt-1">Zero tax for income up to ₹12L under New Regime (with Section 87A rebate)</p>
    <a href="{{ url('tools:detail', args=['old-vs-new-tax-regime']) }}"
       class="inline-block mt-4 bg-green-600 hover:bg-green-700 text-white font-semibold px-6 py-2.5 rounded-xl text-sm transition-colors">
      Check your savings → Old vs New Regime Calculator
    </a>
  </div>

  {# Changes summary #}
  <div class="space-y-8">

    {# New Regime Slabs #}
    <section>
      <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
        <span class="w-8 h-8 bg-primary text-white rounded-lg flex items-center justify-center text-sm font-bold">1</span>
        New Regime Tax Slabs — FY 2025-26
      </h2>
      <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 overflow-hidden">
        <table class="w-full text-sm">
          <thead class="bg-gray-50 dark:bg-gray-700">
            <tr>
              <th class="px-4 py-3 text-left font-semibold text-gray-700 dark:text-gray-300">Income Slab</th>
              <th class="px-4 py-3 text-right font-semibold text-gray-700 dark:text-gray-300">Tax Rate</th>
              <th class="px-4 py-3 text-right font-semibold text-gray-700 dark:text-gray-300">Change from FY 2024-25</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
            {% set slabs = [
              ('Up to ₹4,00,000', 'Nil', 'Was ₹3L — ₹1L increase ✅'),
              ('₹4,00,001 – ₹8,00,000', '5%', 'Was 5% on ₹3L–₹7L — same rate'),
              ('₹8,00,001 – ₹12,00,000', '10%', 'New slab — was 10% on ₹7L–₹10L'),
              ('₹12,00,001 – ₹16,00,000', '15%', 'New slab — was 15% on ₹10L–₹12L'),
              ('₹16,00,001 – ₹20,00,000', '20%', 'Was 20% on ₹12L–₹15L'),
              ('₹20,00,001 – ₹24,00,000', '25%', 'Same as before'),
              ('Above ₹24,00,000', '30%', 'Same — no change'),
            ] %}
            {% for slab, rate, note in slabs %}
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
              <td class="px-4 py-3 text-gray-700 dark:text-gray-300">{{ slab }}</td>
              <td class="px-4 py-3 text-right font-semibold {% if rate == 'Nil' %}text-green-600 dark:text-green-400{% else %}text-gray-900 dark:text-white{% endif %}">{{ rate }}</td>
              <td class="px-4 py-3 text-right text-xs text-gray-500 dark:text-gray-400">{{ note }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      <p class="text-xs text-gray-500 dark:text-gray-400 mt-2 px-1">+ 4% Health & Education Cess on tax payable. Surcharge applicable above ₹50L.</p>
    </section>

    {# Key changes #}
    <section>
      <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
        <span class="w-8 h-8 bg-primary text-white rounded-lg flex items-center justify-center text-sm font-bold">2</span>
        Key Changes at a Glance
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {% set changes = [
          ('87A Rebate', '₹12L → Zero tax', 'Was ₹7L. New regime only. Income up to ₹12L = ₹0 tax after rebate.', 'green'),
          ('Standard Deduction', '₹75,000', 'Was ₹50,000. Applicable under New Regime for salaried employees.', 'blue'),
          ('Effective zero-tax limit', '₹12.75L', 'For salaried: ₹12L income + ₹75K std deduction = ₹0 tax.', 'green'),
          ('Old Regime slabs', 'Unchanged', 'Old regime slabs, limits, and deductions remain same as FY 2024-25.', 'gray'),
          ('NPS Employer contribution', 'Raised to 14%', 'Employer NPS contribution deduction raised from 10% to 14% of salary.', 'blue'),
          ('TDS on rent', '₹6L threshold', 'TDS on rent threshold raised from ₹2.4L to ₹6L per year.', 'amber'),
        ] %}
        {% for title, value, desc, color in changes %}
        {% set color_map = {
          'green': 'border-green-200 dark:border-green-800 bg-green-50 dark:bg-green-900/20',
          'blue': 'border-blue-200 dark:border-blue-800 bg-blue-50 dark:bg-blue-900/20',
          'amber': 'border-amber-200 dark:border-amber-800 bg-amber-50 dark:bg-amber-900/20',
          'gray': 'border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800',
        } %}
        <div class="border rounded-xl p-4 {{ color_map.get(color, color_map['gray']) }}">
          <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">{{ title }}</p>
          <p class="text-lg font-bold text-gray-900 dark:text-white mt-1">{{ value }}</p>
          <p class="text-xs text-gray-600 dark:text-gray-400 mt-1">{{ desc }}</p>
        </div>
        {% endfor %}
      </div>
    </section>

    {# Who benefits most #}
    <section>
      <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
        <span class="w-8 h-8 bg-primary text-white rounded-lg flex items-center justify-center text-sm font-bold">3</span>
        Who Benefits Most?
      </h2>
      <div class="space-y-3">
        {% set beneficiaries = [
          ('💼 Salaried up to ₹12.75L', 'Zero tax! ₹12L rebate + ₹75K standard deduction. Max benefit from Budget 2025.'),
          ('👶 Young earners ₹8L–₹12L', 'Significant relief — new slabs reduce tax vs old rates.'),
          ('🏢 Employees in NPS companies', 'Employer NPS deduction raised to 14% — more tax-free retirement savings.'),
          ('🏠 Landlords below ₹6L rent', 'No TDS deduction hassle on rental income up to ₹6L/year.'),
          ('👴 Senior Citizens', 'TDS exemption on interest raised from ₹50K to ₹1L under Section 194A.'),
        ] %}
        {% for who, benefit in beneficiaries %}
        <div class="flex items-start gap-3 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-4">
          <span class="text-xl flex-shrink-0">✅</span>
          <div>
            <p class="font-semibold text-gray-900 dark:text-white text-sm">{{ who }}</p>
            <p class="text-xs text-gray-600 dark:text-gray-400 mt-0.5">{{ benefit }}</p>
          </div>
        </div>
        {% endfor %}
      </div>
    </section>

    {# Calculator CTAs #}
    <section class="bg-primary/5 dark:bg-primary/10 border border-primary/20 rounded-2xl p-6">
      <h2 class="text-lg font-bold text-gray-900 dark:text-white mb-4">Calculate Your Tax — FY 2025-26</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {% set ctatools = [
          ('old-vs-new-tax-regime', 'Old vs New Regime — Which saves more?', '⚖️'),
          ('income-tax-calculator', 'Income Tax Calculator FY 2025-26', '🧮'),
          ('advance-tax-calculator', 'Advance Tax — Do you need to pay?', '📅'),
          ('80c-deduction-calculator', '80C Deductions — How much can you save?', '💰'),
        ] %}
        {% for slug, name, icon in ctatools %}
        <a href="{{ url('tools:detail', args=[slug]) }}"
           class="flex items-center gap-3 bg-white dark:bg-gray-800 hover:border-primary border border-gray-200 dark:border-gray-700 rounded-xl p-3 transition-all group">
          <span class="text-2xl">{{ icon }}</span>
          <span class="text-sm font-medium text-gray-700 dark:text-gray-300 group-hover:text-primary transition-colors">{{ name }}</span>
        </a>
        {% endfor %}
      </div>
    </section>

  </div>

  {# Disclaimer #}
  <div class="mt-8 p-4 bg-amber-50 dark:bg-amber-900/10 border border-amber-200 dark:border-amber-800 rounded-xl text-sm text-amber-800 dark:text-amber-300">
    <strong>Disclaimer:</strong> Based on Finance Bill 2025 as presented on February 1, 2025. Subject to parliamentary approval. Consult a Chartered Accountant for tax planning specific to your situation.
  </div>

</div>
{% endblock %}
