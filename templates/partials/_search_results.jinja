{% if q %}
<div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl shadow-lg overflow-hidden mt-2 max-h-80 overflow-y-auto">
  {% if tools %}
  <div class="px-4 py-2 bg-gray-50 dark:bg-gray-900 border-b border-gray-100 dark:border-gray-700">
    <p class="text-xs font-semibold text-gray-400 uppercase">Tools</p>
  </div>
  {% for tool in tools %}
  <a href="{{ tool.get_absolute_url() }}" class="flex items-center gap-3 px-4 py-3 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors border-b border-gray-50 dark:border-gray-700 last:border-0">
    <span class="text-lg">🧮</span>
    <div>
      <p class="text-sm font-medium text-gray-900 dark:text-white">{{ tool.name }}</p>
      <p class="text-xs text-gray-400 line-clamp-1">{{ tool.short_desc }}</p>
    </div>
  </a>
  {% endfor %}
  {% endif %}

  {% if articles %}
  <div class="px-4 py-2 bg-gray-50 dark:bg-gray-900 border-b border-gray-100 dark:border-gray-700">
    <p class="text-xs font-semibold text-gray-400 uppercase">Articles</p>
  </div>
  {% for article in articles %}
  <a href="{{ article.get_absolute_url() }}" class="flex items-start gap-3 px-4 py-3 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors border-b border-gray-50 dark:border-gray-700 last:border-0">
    <span class="text-lg">📄</span>
    <p class="text-sm font-medium text-gray-900 dark:text-white line-clamp-2">{{ article.title }}</p>
  </a>
  {% endfor %}
  {% endif %}

  {% if not tools and not articles %}
  <p class="px-4 py-6 text-sm text-gray-400 text-center">No results for "{{ q }}"</p>
  {% endif %}
</div>
{% endif %}
