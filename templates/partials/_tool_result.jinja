{% if error %}
<div class="p-4 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-xl text-sm text-red-600 dark:text-red-400">
  {{ error }}
</div>

{% elif result %}

{# ══════════════════════════════════════════════════════════════════════
   US TOOL RESULTS
   ══════════════════════════════════════════════════════════════════════ #}

{# ── US Federal Income Tax ─────────────────────────────────────────── #}
{% if result.type == 'us_federal_tax' %}
<div class="space-y-4">
  <div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-xl p-4 text-center">
    <p class="text-xs text-gray-500 dark:text-gray-400 uppercase font-semibold tracking-wide">Federal Tax Owed — {{ result.filing_status_label }}</p>
    <p class="text-4xl font-bold text-gray-900 dark:text-white mt-1">${{ '{:,.0f}'.format(result.federal_tax) }}</p>
    <p class="text-sm text-gray-500 mt-1">Effective rate: <strong>{{ result.effective_rate }}%</strong> &nbsp;·&nbsp; Marginal rate: <strong>{{ result.marginal_rate_pct }}</strong></p>
  </div>

  <div class="grid grid-cols-2 gap-3">
    <div class="bg-gray-50 dark:bg-gray-700 rounded-xl p-3 text-center">
      <p class="text-xs text-gray-500">Taxable Income</p>
      <p class="font-bold text-gray-900 dark:text-white">${{ '{:,.0f}'.format(result.taxable_income) }}</p>
    </div>
    <div class="bg-green-50 dark:bg-green-900/20 rounded-xl p-3 text-center">
      <p class="text-xs text-gray-500">Take-Home (after fed tax)</p>
      <p class="font-bold text-green-600 dark:text-green-400">${{ '{:,.0f}'.format(result.take_home) }}</p>
    </div>
    <div class="bg-gray-50 dark:bg-gray-700 rounded-xl p-3 text-center">
      <p class="text-xs text-gray-500">{{ result.deduction_type }} Deduction</p>
      <p class="font-bold text-gray-900 dark:text-white">${{ '{:,.0f}'.format(result.deduction) }}</p>
    </div>
    {% if result.total_credits > 0 %}
    <div class="bg-green-50 dark:bg-green-900/20 rounded-xl p-3 text-center">
      <p class="text-xs text-gray-500">Credits Applied</p>
      <p class="font-bold text-green-600 dark:text-green-400">-${{ '{:,.0f}'.format(result.total_credits) }}</p>
    </div>
    {% endif %}
  </div>

  {# Bracket breakdown #}
  {% if result.breakdown %}
  <div>
    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Tax Bracket Breakdown</p>
    <div class="space-y-1">
      {% for b in result.breakdown %}
      <div class="flex items-center justify-between text-sm bg-gray-50 dark:bg-gray-700 rounded-lg px-3 py-2">
        <span class="text-gray-600 dark:text-gray-400">{{ b.rate_pct }} bracket &nbsp;·&nbsp; ${{ '{:,.0f}'.format(b.income_in_bracket) }}</span>
        <span class="font-semibold text-gray-900 dark:text-white">${{ '{:,.0f}'.format(b.tax) }}</span>
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}
</div>

{# ── US Tax Refund Estimator ───────────────────────────────────────── #}
{% elif result.type == 'us_refund' %}
<div class="space-y-4">
  {% if result.is_refund %}
  <div class="bg-green-50 dark:bg-green-900/20 border-2 border-green-400 dark:border-green-600 rounded-xl p-5 text-center">
    <p class="text-green-700 dark:text-green-400 font-bold text-lg">🎉 Estimated Refund</p>
    <p class="text-4xl font-bold text-green-600 dark:text-green-400 mt-1">${{ '{:,.0f}'.format(result.refund) }}</p>
    <p class="text-xs text-gray-500 mt-2">The IRS will refund this amount (typically in 21 days for e-file)</p>
  </div>
  {% else %}
  <div class="bg-red-50 dark:bg-red-900/20 border-2 border-red-400 dark:border-red-600 rounded-xl p-5 text-center">
    <p class="text-red-700 dark:text-red-400 font-bold text-lg">⚠️ Amount Owed to IRS</p>
    <p class="text-4xl font-bold text-red-600 dark:text-red-400 mt-1">${{ '{:,.0f}'.format(result.owe) }}</p>
    <p class="text-xs text-gray-500 mt-2">Due by April 15, 2026. Consider adjusting your W-4 withholding.</p>
  </div>
  {% endif %}

  <div class="grid grid-cols-2 gap-3">
    <div class="bg-gray-50 dark:bg-gray-700 rounded-xl p-3 text-center">
      <p class="text-xs text-gray-500">Tax Owed</p>
      <p class="font-bold text-gray-900 dark:text-white">${{ '{:,.0f}'.format(result.tax_owed) }}</p>
    </div>
    <div class="bg-gray-50 dark:bg-gray-700 rounded-xl p-3 text-center">
      <p class="text-xs text-gray-500">Tax Withheld</p>
      <p class="font-bold text-gray-900 dark:text-white">${{ '{:,.0f}'.format(result.withholding) }}</p>
    </div>
  </div>
  <p class="text-xs text-center text-gray-400">Effective tax rate: {{ result.effective_rate }}% · {{ result.filing_status_label }}</p>
</div>

{# ── US Self-Employment Tax ────────────────────────────────────────── #}
{% elif result.type == 'us_se_tax' %}
<div class="space-y-4">
  <div class="bg-orange-50 dark:bg-orange-900/20 border border-orange-200 dark:border-orange-800 rounded-xl p-4 text-center">
    <p class="text-xs text-gray-500 font-semibold uppercase tracking-wide">Total Tax (SE + Federal)</p>
    <p class="text-4xl font-bold text-gray-900 dark:text-white mt-1">${{ '{:,.0f}'.format(result.total_tax) }}</p>
    <p class="text-sm text-gray-500 mt-1">{{ result.effective_total_rate }}% of net profit</p>
  </div>

  <div class="grid grid-cols-2 gap-3">
    <div class="bg-red-50 dark:bg-red-900/20 rounded-xl p-3 text-center">
      <p class="text-xs text-gray-500">SE Tax (15.3%)</p>
      <p class="font-bold text-red-600 dark:text-red-400">${{ '{:,.0f}'.format(result.se_tax) }}</p>
      <p class="text-xs text-gray-400">SS: ${{ '{:,.0f}'.format(result.ss_tax) }} + Med: ${{ '{:,.0f}'.format(result.medicare_tax) }}</p>
    </div>
    <div class="bg-blue-50 dark:bg-blue-900/20 rounded-xl p-3 text-center">
      <p class="text-xs text-gray-500">Federal Income Tax</p>
      <p class="font-bold text-blue-600 dark:text-blue-400">${{ '{:,.0f}'.format(result.federal_tax) }}</p>
      <p class="text-xs text-gray-400">After SE deduction of ${{ '{:,.0f}'.format(result.se_deduction) }}</p>
    </div>
    <div class="bg-green-50 dark:bg-green-900/20 rounded-xl p-3 text-center">
      <p class="text-xs text-gray-500">Take-Home</p>
      <p class="font-bold text-green-600 dark:text-green-400">${{ '{:,.0f}'.format(result.take_home) }}</p>
    </div>
    <div class="bg-amber-50 dark:bg-amber-900/20 rounded-xl p-3 text-center">
      <p class="text-xs text-gray-500">Quarterly Payment</p>
      <p class="font-bold text-amber-600 dark:text-amber-400">${{ '{:,.0f}'.format(result.quarterly_payment) }}</p>
      <p class="text-xs text-gray-400">Due Apr / Jun / Sep / Jan</p>
    </div>
  </div>

  <div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-xl p-3 text-xs text-blue-700 dark:text-blue-300">
    <strong>Tip:</strong> Deduct ${{ '{:,.0f}'.format(result.se_deduction) }} (half of SE tax) from income on Schedule 1, Line 15. Already reflected above.
  </div>
</div>

{# ── US Paycheck ───────────────────────────────────────────────────── #}
{% elif result.type == 'us_paycheck' %}
<div class="space-y-4">
  <div class="bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-xl p-4 text-center">
    <p class="text-xs text-gray-500 font-semibold uppercase tracking-wide">Net Take-Home — {{ result.pay_frequency | title }}</p>
    <p class="text-4xl font-bold text-green-600 dark:text-green-400 mt-1">${{ '{:,.2f}'.format(result.net_take_home_per_period) }}</p>
    <p class="text-sm text-gray-500 mt-1">Per paycheck · ${{ '{:,.0f}'.format(result.net_take_home_annual) }}/year</p>
  </div>

  <div class="space-y-2">
    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Per Paycheck Breakdown</p>
    {% set rows = [
      ('Gross Pay', result.gross_per_period, 'text-gray-900 dark:text-white', '+'),
      ('Federal Income Tax', result.federal_tax_per_period, 'text-red-600 dark:text-red-400', '-'),
      ('Social Security (6.2%)', result.ss_per_period, 'text-red-600 dark:text-red-400', '-'),
      ('Medicare (1.45%)', result.medicare_per_period, 'text-red-600 dark:text-red-400', '-'),
    ] %}
    {% for label, val, cls, sign in rows %}
    <div class="flex justify-between items-center bg-gray-50 dark:bg-gray-700 rounded-lg px-3 py-2 text-sm">
      <span class="text-gray-600 dark:text-gray-400">{{ label }}</span>
      <span class="{{ cls }} font-semibold">{{ sign }}${{ '{:,.2f}'.format(val) }}</span>
    </div>
    {% endfor %}
    {% if result.state_tax_per_period > 0 %}
    <div class="flex justify-between items-center bg-gray-50 dark:bg-gray-700 rounded-lg px-3 py-2 text-sm">
      <span class="text-gray-600 dark:text-gray-400">State Income Tax</span>
      <span class="text-red-600 dark:text-red-400 font-semibold">-${{ '{:,.2f}'.format(result.state_tax_per_period) }}</span>
    </div>
    {% endif %}
    {% if result.pre_tax_per_period > 0 %}
    <div class="flex justify-between items-center bg-gray-50 dark:bg-gray-700 rounded-lg px-3 py-2 text-sm">
      <span class="text-gray-600 dark:text-gray-400">Pre-tax Deductions (401k/HSA)</span>
      <span class="text-gray-600 dark:text-gray-400 font-semibold">-${{ '{:,.2f}'.format(result.pre_tax_per_period) }}</span>
    </div>
    {% endif %}
    <div class="flex justify-between items-center bg-green-50 dark:bg-green-900/20 rounded-lg px-3 py-2.5 text-sm border border-green-200 dark:border-green-800">
      <span class="font-semibold text-gray-900 dark:text-white">Net Take-Home</span>
      <span class="font-bold text-green-600 dark:text-green-400">${{ '{:,.2f}'.format(result.net_take_home_per_period) }}</span>
    </div>
  </div>
  <p class="text-xs text-center text-gray-400">Effective tax rate (fed + FICA): {{ result.effective_rate }}% · {{ result.filing_status_label }}</p>
</div>

{# ── US Capital Gains ──────────────────────────────────────────────── #}
{% elif result.type == 'us_capital_gains' %}
<div class="space-y-4">
  <div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-xl p-4 text-center">
    <p class="text-xs text-gray-500 font-semibold uppercase tracking-wide">Total Capital Gains Tax</p>
    <p class="text-4xl font-bold text-gray-900 dark:text-white mt-1">${{ '{:,.0f}'.format(result.total_tax) }}</p>
    <p class="text-sm text-gray-500 mt-1">Effective rate on gains: {{ result.effective_rate }}%</p>
  </div>

  <div class="grid grid-cols-2 gap-3">
    {% if result.short_term_gain > 0 %}
    <div class="bg-red-50 dark:bg-red-900/20 rounded-xl p-3 text-center">
      <p class="text-xs text-gray-500">Short-Term Tax</p>
      <p class="font-bold text-red-600 dark:text-red-400">${{ '{:,.0f}'.format(result.st_tax) }}</p>
      <p class="text-xs text-gray-400">Ordinary income rates</p>
    </div>
    {% endif %}
    {% if result.long_term_gain > 0 %}
    <div class="bg-green-50 dark:bg-green-900/20 rounded-xl p-3 text-center">
      <p class="text-xs text-gray-500">Long-Term Tax</p>
      <p class="font-bold text-green-600 dark:text-green-400">${{ '{:,.0f}'.format(result.lt_tax) }}</p>
      <p class="text-xs text-gray-400">Rate: {{ result.lt_rate_pct }}</p>
    </div>
    {% endif %}
    {% if result.niit > 0 %}
    <div class="bg-amber-50 dark:bg-amber-900/20 rounded-xl p-3 text-center col-span-2">
      <p class="text-xs text-gray-500">Net Investment Income Tax (3.8% NIIT)</p>
      <p class="font-bold text-amber-600 dark:text-amber-400">${{ '{:,.0f}'.format(result.niit) }}</p>
    </div>
    {% endif %}
  </div>
  <p class="text-xs text-center text-gray-400">{{ result.filing_status_label }}</p>
</div>

{# ── US Quarterly Estimated Tax ────────────────────────────────────── #}
{% elif result.type == 'us_quarterly' %}
<div class="space-y-4">
  <div class="bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 rounded-xl p-4 text-center">
    <p class="text-xs text-gray-500 font-semibold uppercase tracking-wide">Estimated Annual Tax</p>
    <p class="text-3xl font-bold text-gray-900 dark:text-white mt-1">${{ '{:,.0f}'.format(result.annual_tax) }}</p>
    <p class="text-sm text-gray-500 mt-1">Pay ${{ '{:,.0f}'.format(result.quarterly) }} per quarter</p>
  </div>

  <div class="space-y-2">
    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide">2025 Payment Schedule</p>
    {% set quarters = [
      ('Q1', result.q1_due, result.q1, 'Jan 1 – Mar 31 income'),
      ('Q2', result.q2_due, result.q2, 'Apr 1 – May 31 income'),
      ('Q3', result.q3_due, result.q3, 'Jun 1 – Aug 31 income'),
      ('Q4', result.q4_due, result.q4, 'Sep 1 – Dec 31 income'),
    ] %}
    {% for q, due, amount, period in quarters %}
    <div class="flex items-center justify-between bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-xl px-4 py-3">
      <div>
        <span class="font-bold text-primary dark:text-blue-400 text-sm">{{ q }}</span>
        <span class="text-xs text-gray-500 ml-2">Due: {{ due }}</span>
        <p class="text-xs text-gray-400 mt-0.5">{{ period }}</p>
      </div>
      <span class="font-bold text-gray-900 dark:text-white">${{ '{:,.0f}'.format(amount) }}</span>
    </div>
    {% endfor %}
  </div>

  {% if result.safe_harbor %}
  <div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-xl p-3 text-xs text-blue-700 dark:text-blue-300">
    <strong>Safe Harbor:</strong> Pay ${{ '{:,.0f}'.format(result.safe_harbor_quarterly) }}/quarter (${{ '{:,.0f}'.format(result.safe_harbor) }}/year) to avoid underpayment penalty — based on prior year tax.
  </div>
  {% endif %}
</div>

{# ── US Standard vs Itemized ───────────────────────────────────────── #}
{% elif result.type == 'us_std_vs_itemized' %}
<div class="space-y-4">
  <div class="{% if result.winner == 'standard' %}bg-blue-50 dark:bg-blue-900/20 border-blue-200 dark:border-blue-800{% else %}bg-green-50 dark:bg-green-900/20 border-green-200 dark:border-green-800{% endif %} border rounded-xl p-4 text-center">
    <p class="font-bold text-lg text-gray-900 dark:text-white">
      ✅ Take the {{ result.winner | title }} Deduction
    </p>
    <p class="text-2xl font-bold {% if result.winner == 'standard' %}text-blue-600 dark:text-blue-400{% else %}text-green-600 dark:text-green-400{% endif %} mt-1">
      ${{ '{:,.0f}'.format(result.standard if result.winner == 'standard' else result.itemized) }}
    </p>
    <p class="text-sm text-gray-500 mt-1">Saves you ${{ '{:,.0f}'.format(result.tax_difference) }} more in taxes</p>
  </div>

  <div class="grid grid-cols-2 gap-3">
    <div class="{% if result.winner == 'standard' %}ring-2 ring-blue-400{% endif %} bg-gray-50 dark:bg-gray-700 rounded-xl p-4 text-center">
      <p class="text-xs text-gray-500 uppercase font-semibold">Standard</p>
      <p class="text-2xl font-bold text-gray-900 dark:text-white mt-1">${{ '{:,.0f}'.format(result.standard) }}</p>
      <p class="text-xs text-gray-400 mt-1">{{ result.filing_status_label }}</p>
    </div>
    <div class="{% if result.winner == 'itemized' %}ring-2 ring-green-400{% endif %} bg-gray-50 dark:bg-gray-700 rounded-xl p-4 text-center">
      <p class="text-xs text-gray-500 uppercase font-semibold">Itemized</p>
      <p class="text-2xl font-bold text-gray-900 dark:text-white mt-1">${{ '{:,.0f}'.format(result.itemized) }}</p>
      {% if result.salt_capped %}
      <p class="text-xs text-amber-600 dark:text-amber-400 mt-1">SALT capped at $10K</p>
      {% endif %}
    </div>
  </div>
</div>

{# ── Regime Comparison result ──────────────────────────────────────── #}
{% if result.winner is defined and result.winner_label is defined %}
<div class="space-y-4">

  {# Winner Banner #}
  <div class="{% if result.winner == 'new' %}bg-green-50 dark:bg-green-900/20 border-green-200 dark:border-green-800{% else %}bg-blue-50 dark:bg-blue-900/20 border-blue-200 dark:border-blue-800{% endif %} border rounded-xl p-4">
    <p class="font-bold text-lg text-gray-900 dark:text-white">
      ✅ {{ result.winner_label }} saves you more
    </p>
    <p class="text-2xl font-bold text-green-600 dark:text-green-400 mt-1">
      {{ result.savings | inr }} saved per year
    </p>
    <p class="text-sm text-gray-500 dark:text-gray-400">= {{ result.savings_monthly | inr }} per month</p>
  </div>

  {# Side-by-side comparison #}
  <div class="grid grid-cols-2 gap-3">
    {% for regime_key, label in [('new', 'New Regime'), ('old', 'Old Regime')] %}
    {% set r = result[regime_key] %}
    <div class="{% if result.winner == regime_key %}ring-2 ring-green-400{% endif %} bg-gray-50 dark:bg-gray-700 rounded-xl p-4">
      <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase mb-2">{{ label }}</p>
      <p class="text-xl font-bold text-gray-900 dark:text-white">{{ r.total_tax | inr }}</p>
      <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Total Tax (incl. cess)</p>
      <div class="mt-3 space-y-1 text-xs text-gray-600 dark:text-gray-400">
        <div class="flex justify-between">
          <span>Effective Rate</span>
          <span class="font-medium">{{ r.effective_rate }}%</span>
        </div>
        <div class="flex justify-between">
          <span>Take-Home/mo</span>
          <span class="font-medium">{{ r.take_home_monthly | inr }}</span>
        </div>
      </div>
      {% if result.winner == regime_key %}
      <p class="mt-2 text-xs font-semibold text-green-600 dark:text-green-400">✓ Recommended</p>
      {% endif %}
    </div>
    {% endfor %}
  </div>

  {# WhatsApp Share #}
  <a href="https://wa.me/?text={{ ('TaxSaver India: ' + result.winner_label + ' saves me ' + (result.savings | inr) + ' per year! Check here: ') | urlencode }}{{ request.build_absolute_uri() | urlencode }}"
     target="_blank" rel="noopener"
     class="flex items-center justify-center gap-2 bg-[#25D366] hover:bg-green-500 text-white font-medium py-2.5 rounded-xl text-sm transition-colors">
    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.124.558 4.117 1.532 5.843L0 24l6.351-1.507A11.945 11.945 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.795 9.795 0 01-5.03-1.384l-.36-.214-3.732.884.936-3.617-.234-.373A9.777 9.777 0 012.182 12C2.182 6.57 6.57 2.182 12 2.182S21.818 6.57 21.818 12 17.43 21.818 12 21.818z"/></svg>
    Share on WhatsApp
  </a>
</div>

{# ── Generic single-regime result ──────────────────────────────────── #}
{% elif result.total_tax is defined and result.take_home_yearly is defined %}
<div class="space-y-4">
  <div class="bg-primary/5 dark:bg-primary/10 border border-primary/20 rounded-xl p-5">
    <p class="text-sm text-gray-500 dark:text-gray-400">Total Tax Payable (incl. cess)</p>
    <p class="text-3xl font-bold text-primary dark:text-blue-400 mt-1">{{ result.total_tax | inr }}</p>
  </div>

  <div class="grid grid-cols-2 gap-3">
    {% for label, val in [('Take-Home/Year', result.take_home_yearly), ('Take-Home/Month', result.take_home_monthly), ('Effective Rate', result.effective_rate|string + '%'), ('Marginal Rate', result.marginal_rate|string + '%')] %}
    <div class="bg-gray-50 dark:bg-gray-700 rounded-xl p-3">
      <p class="text-xs text-gray-500 dark:text-gray-400">{{ label }}</p>
      <p class="font-bold text-gray-900 dark:text-white mt-1 text-sm">{% if '%' in val|string %}{{ val }}{% else %}{{ val | inr }}{% endif %}</p>
    </div>
    {% endfor %}
  </div>

  {# Slab breakdown #}
  {% if result.breakdown %}
  <details class="bg-gray-50 dark:bg-gray-700 rounded-xl">
    <summary class="px-4 py-3 text-sm font-medium text-gray-700 dark:text-gray-300 cursor-pointer">View slab breakdown</summary>
    <div class="px-4 pb-4">
      <table class="w-full text-xs mt-2">
        <thead>
          <tr class="text-gray-400 border-b border-gray-200 dark:border-gray-600">
            <th class="text-left pb-2">Slab</th>
            <th class="text-right pb-2">Rate</th>
            <th class="text-right pb-2">Tax</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
          {% for slab in result.breakdown %}
          <tr class="text-gray-600 dark:text-gray-400">
            <td class="py-1.5">{{ slab.from | inr }} – {{ slab.to | inr }}</td>
            <td class="text-right">{{ slab.rate }}%</td>
