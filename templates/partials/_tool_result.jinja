{% elif result.gross_turnover is defined %}
<div class="space-y-4">
  <div class="bg-primary/5 dark:bg-primary/10 border border-primary/20 rounded-xl p-5">
    <p class="text-sm text-gray-500 dark:text-gray-400">Presumptive Income ({{ result.presumptive_pct }}% of turnover)</p>
    <p class="text-2xl font-bold text-primary dark:text-blue-400 mt-1">{{ result.presumptive_income | inr }}</p>
    <p class="text-xs text-gray-400 mt-1">On turnover of {{ result.gross_turnover | inr }}</p>
  </div>
  <div class="grid grid-cols-2 gap-3">
    {% for key, label in [('new_regime','New Regime'),('old_regime','Old Regime')] %}
    {% set r = result[key] %}
    <div class="{% if result.winner == key.split('_')[0] %}ring-2 ring-green-400{% endif %} bg-gray-50 dark:bg-gray-700 rounded-xl p-4">
      <p class="text-xs font-semibold text-gray-400 uppercase mb-1">{{ label }}</p>
      <p class="text-xl font-bold text-gray-900 dark:text-white">{{ r.total_tax | inr }}</p>
      <p class="text-xs text-gray-400">{{ r.effective_rate }}% effective rate</p>
      {% if result.winner == key.split('_')[0] %}<p class="text-xs text-green-600 mt-1 font-semibold">✓ Recommended</p>{% endif %}
    </div>
    {% endfor %}
  </div>
  {% if result.gross_turnover > result.limit %}
  <p class="text-xs text-red-600 dark:text-red-400 bg-red-50 dark:bg-red-900/10 border border-red-200 dark:border-red-800 rounded-lg p-3">⚠ Turnover exceeds ₹3Cr limit for 44AD. You must maintain actual books of accounts.</p>
  {% endif %}
</div>

{# ── 44ADA Professionals Presumptive result ────────────────────────── #}
{% elif result.gross_receipts is defined and result.new_regime is defined %}
<div class="space-y-4">
  <div class="bg-primary/5 dark:bg-primary/10 border border-primary/20 rounded-xl p-5">
    <p class="text-sm text-gray-500 dark:text-gray-400">Presumptive Income (50% of gross receipts)</p>
    <p class="text-2xl font-bold text-primary dark:text-blue-400 mt-1">{{ result.presumptive_income | inr }}</p>
    <p class="text-xs text-gray-400 mt-1">On gross receipts of {{ result.gross_receipts | inr }}</p>
  </div>
  <div class="grid grid-cols-2 gap-3">
    {% for key, label in [('new_regime','New Regime'),('old_regime','Old Regime')] %}
    {% set r = result[key] %}
    <div class="{% if result.winner == key.split('_')[0] %}ring-2 ring-green-400{% endif %} bg-gray-50 dark:bg-gray-700 rounded-xl p-4">
      <p class="text-xs font-semibold text-gray-400 uppercase mb-1">{{ label }}</p>
      <p class="text-xl font-bold text-gray-900 dark:text-white">{{ r.total_tax | inr }}</p>
      <p class="text-xs text-gray-400">{{ r.effective_rate }}% effective rate</p>
      {% if result.winner == key.split('_')[0] %}<p class="text-xs text-green-600 mt-1 font-semibold">✓ Recommended</p>{% endif %}
    </div>
    {% endfor %}
  </div>
  <p class="text-xs text-gray-400 p-3 bg-gray-50 dark:bg-gray-700 rounded-lg">Section 44ADA: Professionals (CA, doctor, lawyer, engineer) with gross receipts up to ₹75L can declare 50% as presumptive income — no need to maintain books.</p>
</div>

{# ── Freelancer Tax Plan result ───────────────────────────────────── #}
{% elif result.quarterly_tax is defined and result.itr_form is defined %}
<div class="space-y-4">
  <div class="bg-primary/5 dark:bg-primary/10 border border-primary/20 rounded-xl p-5">
    <p class="text-sm text-gray-500 dark:text-gray-400">Annual Tax (on {{ result.presumptive_income | inr }} presumptive income)</p>
    <p class="text-2xl font-bold text-primary dark:text-blue-400 mt-1">{{ result.total_tax | inr }}</p>
    <p class="text-xs text-gray-400 mt-1">Effective rate: {{ result.effective_rate }}%</p>
  </div>
  <div class="bg-gray-50 dark:bg-gray-700 rounded-xl p-4 space-y-2 text-sm">
    <div class="flex justify-between text-gray-600 dark:text-gray-400"><span>Gross Receipts</span><span class="font-medium">{{ result.gross_receipts | inr }}</span></div>
    <div class="flex justify-between text-gray-600 dark:text-gray-400"><span>Presumptive Income (50%)</span><span class="font-medium">{{ result.presumptive_income | inr }}</span></div>
    <div class="flex justify-between text-gray-600 dark:text-gray-400"><span>ITR Form to File</span><span class="font-bold text-primary">{{ result.itr_form }}</span></div>
    {% if result.quarterly_tax > 0 %}
    <div class="flex justify-between text-orange-600 dark:text-orange-400"><span>Approx. Quarterly Advance Tax</span><span class="font-bold">{{ result.quarterly_tax | inr }}</span></div>
    {% endif %}
  </div>
</div>

{# ── Property Capital Gains result ───────────────────────────────── #}
{% elif result.holding_months is defined %}
<div class="space-y-3">
  {% if result.gain_type == 'STCG' %}
  <div class="bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 rounded-xl p-5">
    <p class="text-sm font-semibold text-amber-700 dark:text-amber-400">Short-Term Capital Gain (STCG)</p>
    <p class="text-2xl font-bold text-amber-700 dark:text-amber-400 mt-1">{{ result.total_gain | inr }}</p>
    <p class="text-xs text-amber-600 dark:text-amber-400 mt-1">Taxed at your income slab rate — add to total income</p>
  </div>
  {% else %}
  <div class="bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-xl p-5">
    <p class="text-sm font-semibold text-gray-600 dark:text-gray-400">Long-Term Capital Gain (LTCG)</p>
    <p class="text-2xl font-bold text-green-600 dark:text-green-400 mt-1">{{ result.total_gain | inr }}</p>
    <div class="flex justify-between text-sm mt-2"><span class="text-gray-500">Tax @{{ result.tax_rate }}%</span><span class="font-bold text-red-500">{{ result.total_tax | inr }}</span></div>
    <div class="flex justify-between text-sm"><span class="text-gray-500">Net Profit</span><span class="font-bold text-green-600">{{ result.net_profit | inr }}</span></div>
  </div>
  {% endif %}
  <p class="text-xs text-gray-400 p-3 bg-gray-50 dark:bg-gray-700 rounded-lg">{{ result.note }}</p>
</div>

{# ── Mutual Fund Tax result ────────────────────────────────────────── #}
{% elif result.fund_type is defined %}
<div class="space-y-3">
  {% if result.is_debt %}
  <div class="bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 rounded-xl p-5">
    <p class="text-sm font-semibold text-amber-700 dark:text-amber-400">Debt Fund — Taxed as Ordinary Income</p>
    <p class="text-2xl font-bold text-amber-700 dark:text-amber-400 mt-1">{{ result.total_gain | inr }} gain</p>
    <p class="text-xs mt-2 text-amber-600 dark:text-amber-400">{{ result.note }}</p>
  </div>
  {% else %}
  <div class="bg-primary/5 dark:bg-primary/10 border border-primary/20 rounded-xl p-5">
    <p class="text-sm text-gray-500 dark:text-gray-400">{{ result.gain_type }} Tax ({{ result.tax_rate }}% + cess)</p>
    <p class="text-2xl font-bold text-primary dark:text-blue-400 mt-1">{{ result.total_tax | inr }}</p>
  </div>
  <div class="bg-gray-50 dark:bg-gray-700 rounded-xl p-4 space-y-2 text-sm">
    <div class="flex justify-between text-gray-600 dark:text-gray-400"><span>Total Gain</span><span>{{ result.total_gain | inr }}</span></div>
    {% if result.exemption %}<div class="flex justify-between text-green-600 dark:text-green-400"><span>LTCG Exemption</span><span>{{ result.exemption | inr }}</span></div>{% endif %}
    <div class="flex justify-between text-gray-600 dark:text-gray-400"><span>Taxable Gain</span><span>{{ result.taxable_gain | inr }}</span></div>
    <div class="flex justify-between font-bold text-gray-900 dark:text-white border-t border-gray-200 dark:border-gray-600 pt-2"><span>Net Profit After Tax</span><span class="text-green-600">{{ result.net_profit | inr }}</span></div>
  </div>
  {% endif %}
</div>

{# ── ELSS vs PPF vs NPS result ────────────────────────────────────── #}
{% elif result.elss is defined %}
<div class="space-y-3">
  <p class="text-xs text-gray-500 dark:text-gray-400">Investing {{ result.annual_investment | inr }}/year for {{ result.years }} years</p>
  {% for key, label, color in [('elss','ELSS','blue'),('ppf','PPF','green'),('nps','NPS','purple')] %}
  {% set inv = result[key] %}
  <div class="bg-{{ color }}-50 dark:bg-{{ color }}-900/20 border border-{{ color }}-200 dark:border-{{ color }}-800 rounded-xl p-4">
    <div class="flex justify-between items-start">
      <div>
        <p class="font-semibold text-{{ color }}-700 dark:text-{{ color }}-400">{{ label }}</p>
        <p class="text-xs text-gray-500 mt-0.5">{{ inv.lock_in }} lock-in | {{ inv.returns }}</p>
      </div>
      <div class="text-right">
        <p class="text-lg font-bold text-gray-900 dark:text-white">{{ inv.net_post_tax | inr }}</p>
        <p class="text-xs text-gray-400">post-tax maturity</p>
      </div>
    </div>
  </div>
  {% endfor %}
  <p class="text-xs text-gray-400 p-3 bg-gray-50 dark:bg-gray-700 rounded-lg">Tax saved/year under 80C: {{ result.tax_saving_per_year | inr }}. Returns shown are estimates — actual returns vary.</p>
</div>

{# ── EPF Maturity result ───────────────────────────────────────────── #}
{% elif result.epf_rate is defined %}
<div class="space-y-3">
  <div class="bg-primary/5 dark:bg-primary/10 border border-primary/20 rounded-xl p-5 text-center">
    <p class="text-sm text-gray-500 dark:text-gray-400">EPF Corpus at Retirement</p>
    <p class="text-3xl font-bold text-primary dark:text-blue-400 mt-1">{{ result.maturity | inr }}</p>
    <p class="text-xs {% if result.is_tax_free %}text-green-500{% else %}text-red-500{% endif %} mt-1">{{ result.tax_note }}</p>
  </div>
  <div class="bg-gray-50 dark:bg-gray-700 rounded-xl p-4 space-y-2 text-sm">
    <div class="flex justify-between text-gray-600 dark:text-gray-400"><span>Monthly contribution (yours)</span><span>{{ result.employee_monthly | inr }}</span></div>
    <div class="flex justify-between text-gray-600 dark:text-gray-400"><span>Monthly contribution (employer)</span><span>{{ result.employer_monthly | inr }}</span></div>
    <div class="flex justify-between text-gray-600 dark:text-gray-400"><span>Annual total</span><span>{{ result.annual_contribution | inr }}</span></div>
    <div class="flex justify-between text-gray-600 dark:text-gray-400"><span>Years / Rate</span><span>{{ result.years }} yrs @ {{ result.epf_rate }}%</span></div>
  </div>
</div>

{# ── PPF Maturity result ───────────────────────────────────────────── #}
{% elif result.ppf_rate is defined %}
<div class="space-y-3">
  <div class="bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-xl p-5 text-center">
    <p class="text-sm text-gray-600 dark:text-gray-400">PPF Maturity Value (Tax-Free)</p>
    <p class="text-3xl font-bold text-green-600 dark:text-green-400 mt-1">{{ result.maturity | inr }}</p>
  </div>
  <div class="bg-gray-50 dark:bg-gray-700 rounded-xl p-4 space-y-2 text-sm">
    <div class="flex justify-between text-gray-600 dark:text-gray-400"><span>Total Invested</span><span>{{ result.total_invested | inr }}</span></div>
    <div class="flex justify-between text-green-600 dark:text-green-400"><span>Interest Earned</span><span class="font-bold">{{ result.interest_earned | inr }}</span></div>
    <div class="flex justify-between font-bold text-gray-900 dark:text-white border-t border-gray-200 dark:border-gray-600 pt-2"><span>Maturity (Tax-Free)</span><span>{{ result.maturity | inr }}</span></div>
  </div>
  <p class="text-xs text-gray-400 p-3 bg-gray-50 dark:bg-gray-700 rounded-lg">{{ result.note }}</p>
</div>

{# ── Gratuity result ───────────────────────────────────────────────── #}
{% elif result.gratuity is defined %}
<div class="space-y-3">
  <div class="bg-primary/5 dark:bg-primary/10 border border-primary/20 rounded-xl p-5 text-center">
    <p class="text-sm text-gray-500 dark:text-gray-400">Gratuity Amount</p>
    <p class="text-3xl font-bold text-primary dark:text-blue-400 mt-1">{{ result.gratuity | inr }}</p>
    <p class="text-xs text-green-500 mt-1">Tax-Free: {{ result.tax_free_gratuity | inr }}</p>
  </div>
  <div class="bg-gray-50 dark:bg-gray-700 rounded-xl p-4 space-y-2 text-sm">
    <div class="flex justify-between text-gray-600 dark:text-gray-400"><span>Formula</span><span class="font-mono text-xs">{{ result.formula }}</span></div>
    <div class="flex justify-between text-gray-600 dark:text-gray-400"><span>Years of Service</span><span>{{ result.years_of_service }}</span></div>
    {% if not result.is_govt and result.taxable_gratuity > 0 %}
    <div class="flex justify-between text-red-500"><span>Taxable Gratuity (above ₹20L)</span><span>{{ result.taxable_gratuity | inr }}</span></div>
    {% else %}
    <p class="text-xs text-green-600 dark:text-green-400">✓ Fully tax-exempt {% if result.is_govt %}(government employee){% else %}(within ₹20L limit){% endif %}</p>
    {% endif %}
  </div>
</div>

{# ── Senior Citizen Tax result ─────────────────────────────────────── #}
{% elif result.ttb_deduction is defined %}
<div class="space-y-4">
  <div class="grid grid-cols-2 gap-3">
    {% for key, label in [('new_regime','New Regime'),('old_regime','Old Regime')] %}
    {% set r = result[key] %}
    <div class="{% if result.winner == key.split('_')[0] %}ring-2 ring-green-400{% endif %} bg-gray-50 dark:bg-gray-700 rounded-xl p-4">
      <p class="text-xs font-semibold text-gray-400 uppercase mb-1">{{ label }}</p>
      <p class="text-xl font-bold text-gray-900 dark:text-white">{{ r.total_tax | inr }}</p>
      <p class="text-xs text-gray-400">{{ r.effective_rate }}% effective</p>
      {% if result.winner == key.split('_')[0] %}<p class="text-xs text-green-600 mt-1 font-semibold">✓ Saves more</p>{% endif %}
    </div>
    {% endfor %}
  </div>
  <div class="bg-blue-50 dark:bg-blue-900/10 border border-blue-200 dark:border-blue-800 rounded-xl p-4 text-sm">
    <p class="font-medium text-blue-700 dark:text-blue-400 mb-2">Senior Citizen Deductions (Old Regime)</p>
    <div class="space-y-1 text-blue-600 dark:text-blue-300">
      <div class="flex justify-between"><span>80TTB (FD interest)</span><span>{{ result.ttb_deduction | inr }} (limit {{ result.ttb_limit | inr }})</span></div>
      <div class="flex justify-between"><span>80D (health insurance)</span><span>{{ result.sec_80d_deduction | inr }}</span></div>
    </div>
  </div>
</div>

{# ── Surcharge result ─────────────────────────────────────────────── #}
{% elif result.surcharge_rate is defined %}
<div class="space-y-3">
  <div class="{% if result.surcharge_rate > 0 %}bg-red-50 dark:bg-red-900/20 border-red-200 dark:border-red-800{% else %}bg-green-50 dark:bg-green-900/20 border-green-200 dark:border-green-800{% endif %} border rounded-xl p-5 text-center">
    <p class="text-sm text-gray-500 dark:text-gray-400">Surcharge Rate</p>
    <p class="text-4xl font-bold {% if result.surcharge_rate > 0 %}text-red-600 dark:text-red-400{% else %}text-green-600 dark:text-green-400{% endif %} mt-1">{{ result.surcharge_rate }}%</p>
    {% if result.surcharge_rate == 0 %}<p class="text-xs text-green-500 mt-1">✓ No surcharge — income below ₹50 lakh</p>{% endif %}
  </div>
  <div class="bg-gray-50 dark:bg-gray-700 rounded-xl p-4 space-y-2 text-sm">
    <div class="flex justify-between text-gray-600 dark:text-gray-400"><span>Base Tax (on slabs)</span><span>{{ result.base_tax | inr }}</span></div>
    <div class="flex justify-between text-red-500"><span>Surcharge ({{ result.surcharge_rate }}%)</span><span>{{ result.surcharge_amount | inr }}</span></div>
    <div class="flex justify-between text-gray-600 dark:text-gray-400"><span>Health & Education Cess (4%)</span><span>{{ result.cess | inr }}</span></div>
    <div class="flex justify-between font-bold text-gray-900 dark:text-white border-t border-gray-200 dark:border-gray-600 pt-2"><span>Total Tax</span><span>{{ result.total_tax | inr }}</span></div>
    <div class="flex justify-between text-gray-500"><span>Effective Rate</span><span>{{ result.effective_rate }}%</span></div>
  </div>
</div>

{# ── GST Composition result ───────────────────────────────────────── #}
{% elif result.composition_rate is defined %}
<div class="space-y-3">
  {% if not result.eligible %}
  <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-xl p-4">
    <p class="text-sm font-semibold text-red-700 dark:text-red-400">⚠ Not eligible for Composition Scheme</p>
    <p class="text-xs text-gray-500 mt-1">Your turnover of {{ result.annual_turnover | inr }} exceeds the limit of {{ result.turnover_limit | inr }}.</p>
  </div>
  {% else %}
  <div class="bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-xl p-5 text-center">
    <p class="text-sm text-gray-600 dark:text-gray-400">Annual GST under Composition ({{ result.composition_rate }}%)</p>
    <p class="text-3xl font-bold text-green-600 dark:text-green-400 mt-1">{{ result.annual_tax | inr }}</p>
    <p class="text-xs text-gray-400 mt-1">Quarterly payment: {{ result.quarterly_tax | inr }}</p>
  </div>
  <p class="text-xs text-blue-700 dark:text-blue-400 bg-blue-50 dark:bg-blue-900/10 border border-blue-200 dark:border-blue-800 rounded-lg p-3">💡 Composition scheme = flat rate on turnover. No ITC claim. Simple quarterly GSTR-4 filing.</p>
  {% endif %}
</div>

{# ── GSTR Late Fee result ─────────────────────────────────────────── #}
{% elif result.late_fee is defined %}
<div class="space-y-3">
  <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-xl p-5 text-center">
    <p class="text-sm text-gray-600 dark:text-gray-400">Total Late Fee Liability</p>
    <p class="text-3xl font-bold text-red-600 dark:text-red-400 mt-1">{{ result.total_liability | inr }}</p>
  </div>
  <div class="bg-gray-50 dark:bg-gray-700 rounded-xl p-4 space-y-2 text-sm">
    <div class="flex justify-between text-gray-600 dark:text-gray-400"><span>Return Type</span><span class="font-medium">{{ result.return_type }}</span></div>
    <div class="flex justify-between text-gray-600 dark:text-gray-400"><span>Days Late</span><span class="font-medium">{{ result.days_late }}</span></div>
    <div class="flex justify-between text-gray-600 dark:text-gray-400"><span>Late Fee (₹{{ result.daily_fee }}/day)</span><span class="font-medium">{{ result.late_fee | inr }}</span></div>
    {% if result.interest_estimate > 0 %}
    <div class="flex justify-between text-red-500"><span>Interest @18% (estimate)</span><span>{{ result.interest_estimate | inr }}</span></div>
    {% endif %}
    <p class="text-xs text-gray-400 mt-2">Max cap: {{ result.max_fee | inr }}</p>
  </div>
</div>

{# ── 80E Education Loan result ────────────────────────────────────── #}
{% elif result.max_years is defined %}
<div class="space-y-3">
  {% if result.deduction > 0 %}
  <div class="bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-xl p-5 text-center">
    <p class="text-sm text-gray-600 dark:text-gray-400">Section 80E Deduction (Year {{ result.loan_year }})</p>
    <p class="text-3xl font-bold text-green-600 dark:text-green-400 mt-1">{{ result.deduction | inr }}</p>
    <p class="text-sm text-gray-500 mt-1">Tax Saved: <strong class="text-green-600">{{ result.tax_saved | inr }}</strong></p>
  </div>
  {% else %}
  <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-xl p-5 text-center">
    <p class="text-sm font-semibold text-red-700 dark:text-red-400">80E deduction not available</p>
    <p class="text-xs text-gray-400 mt-1">Exceeded {{ result.max_years }}-year limit</p>
  </div>
  {% endif %}
  <p class="text-xs text-gray-400 p-3 bg-gray-50 dark:bg-gray-700 rounded-lg">{{ result.note }}</p>
</div>

{# ── Professional Tax result ──────────────────────────────────────── #}
{% elif result.monthly_pt is defined %}
<div class="space-y-3">
  <div class="{% if result.has_pt %}bg-primary/5 dark:bg-primary/10 border-primary/20{% else %}bg-green-50 dark:bg-green-900/20 border-green-200{% endif %} border rounded-xl p-5 text-center">
    <p class="text-sm text-gray-500 dark:text-gray-400">Professional Tax ({{ result.state_name }})</p>
    <p class="text-3xl font-bold text-primary dark:text-blue-400 mt-1">{{ result.annual_pt | inr }}/year</p>
    <p class="text-xs text-gray-400 mt-1">₹{{ result.monthly_pt }}/month</p>
  </div>
  <p class="text-xs text-gray-400 p-3 bg-gray-50 dark:bg-gray-700 rounded-lg">{{ result.note }}</p>
</div>

{# ── NPS vs EPF Comparison result ─────────────────────────────────── #}
{% elif result.epf is defined and result.nps is defined %}
<div class="space-y-3">
  <p class="text-xs text-gray-500 dark:text-gray-400">{{ result.basic_salary | inr }}/mo basic × {{ result.years }} years</p>
  {% for key, label, color in [('epf','EPF','blue'),('nps','NPS','purple')] %}
  {% set inv = result[key] %}
  <div class="bg-{{ color }}-50 dark:bg-{{ color }}-900/20 border border-{{ color }}-200 dark:border-{{ color }}-800 rounded-xl p-4">
    <div class="flex justify-between items-start">
      <div>
        <p class="font-semibold text-{{ color }}-700 dark:text-{{ color }}-400">{{ label }}</p>
        <p class="text-xs text-gray-500 mt-0.5">{{ inv.lock_in }} | ~{{ inv.interest_rate }}% returns</p>
        <p class="text-xs text-gray-400 mt-0.5">₹{{ inv.employee_monthly }}/mo contribution</p>
      </div>
      <div class="text-right">
        <p class="text-lg font-bold text-gray-900 dark:text-white">{{ inv.corpus | inr }}</p>
        <p class="text-xs text-gray-400">corpus at maturity</p>
        {% if result.winner == key %}<p class="text-xs text-green-600 font-semibold mt-1">✓ Higher corpus</p>{% endif %}
      </div>
    </div>
  </div>
  {% endfor %}
  <p class="text-xs text-gray-400 p-3 bg-gray-50 dark:bg-gray-700 rounded-lg">NPS: 60% lump sum is tax-free; 40% must be used for annuity (taxable income). EPF is fully tax-free after 5 years. Returns shown are estimates.</p>
</div>

{# ── Tax Saving Checklist result ──────────────────────────────────── #}
{% elif result.items_count is defined %}
<div class="space-y-3">
  {% if result.total_potential_saving > 0 %}
  <div class="bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-xl p-4 text-center">
    <p class="text-sm text-gray-600 dark:text-gray-400">Potential Tax Saving</p>
    <p class="text-2xl font-bold text-green-600 dark:text-green-400 mt-1">{{ result.total_potential_saving | inr }}</p>
  </div>
  {% endif %}
  <div class="space-y-2">
    {% for item in result.items %}
    <div class="flex items-start gap-3 bg-gray-50 dark:bg-gray-700 rounded-xl p-3">
      <span class="{% if item.done %}text-green-500{% elif item.priority == 'high' %}text-red-500{% else %}text-amber-500{% endif %} mt-0.5 flex-shrink-0">
        {% if item.done %}✓{% else %}→{% endif %}
      </span>
      <div class="flex-1">
        <p class="text-xs font-semibold text-gray-500 uppercase">{{ item.section }}</p>
        <p class="text-sm text-gray-700 dark:text-gray-300 mt-0.5">{{ item.action }}</p>
        {% if item.saving > 0 %}<p class="text-xs text-green-600 dark:text-green-400 mt-1">Save: {{ item.saving | inr }}</p>{% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
</div>

{# ── Fallback for other tools ──────────────────────────────────────── #}
{% else %}
<pre class="text-xs text-gray-500 dark:text-gray-400 overflow-auto p-4 bg-gray-50 dark:bg-gray-800 rounded-xl">{{ result }}</pre>
{% endif %}

{# ── WhatsApp share ────────────────────────────────────────────────── #}
