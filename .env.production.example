# Copy this to .env.production and fill in values before deploying

# REQUIRED — generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-generate-a-real-secret-key

# Production: always False
DEBUG=False

# Your server IP or domain (comma-separated, no spaces)
# Example: ALLOWED_HOSTS=taxessaver.com,www.taxessaver.com,1.2.3.4
ALLOWED_HOSTS=159.195.52.197,taxessaver.com,www.taxessaver.com

# Required for HTMX POST and form submissions in production
# Example: CSRF_TRUSTED_ORIGINS=https://taxessaver.com,https://www.taxessaver.com
CSRF_TRUSTED_ORIGINS=http://159.195.52.197:8881,https://taxessaver.com,https://www.taxessaver.com

# SQLite path inside container (persisted via Docker volume → ./data/)
DB_PATH=/app/data/db.sqlite3

# Redis — matches docker-compose service name
REDIS_URL=redis://redis:6379/0

# Optional — Analytics
GA_MEASUREMENT_ID=

# Optional — Error tracking (get DSN from sentry.io)
SENTRY_DSN=

# Optional — Email via Resend.com
RESEND_API_KEY=

# Optional — AdSense (set after approval)
ADSENSE_CLIENT_ID=
ADSENSE_ENABLED=False
